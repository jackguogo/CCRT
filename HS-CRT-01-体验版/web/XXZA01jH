/* ---- 报告与训练方案共用：量表色条 / 范式指标的取值口径 ---- */
const pctOf = (v, max) => Math.max(0, Math.min(100, (Number(v) || 0) / (Number(max) || 1) * 100)).toFixed(2) + "%";
/* 分值色条：异常侧暖色 → 分界处转冷色，转折点与分界竖线对齐 */
const barStyle = (s) => {
  const lo = (s.direction || "higher_better") === "lower_better";
  const p = s.cutoff != null && s.max
    ? Math.max(6, Math.min(94, (Number(s.cutoff) / Number(s.max)) * 100))
    : 50;
  const warm = ["#f2a97e", "#f6dc84"], cool = ["#c9e08a", "#8fd694"];
  return {
    background: lo
      ? `linear-gradient(90deg,${cool[1]} 0%,${cool[0]} ${p}%,${warm[1]} ${p}%,${warm[0]} 100%)`
      : `linear-gradient(90deg,${warm[0]} 0%,${warm[1]} ${p}%,${cool[0]} ${p}%,${cool[1]} 100%)`,
  };
};
/* 参考区间：括号内为分界值，学历分层用浅灰小字追加 */
const rangeMain = (s) => s.cutoff == null
  ? "参考区间（未设分界）"
  : "参考区间（" + ((s.direction || "higher_better") === "lower_better" ? "≤" : "≥") + s.cutoff;
const rangeEdu = (s) => (s.cutoff != null && s.cutoffEdu) ? "，" + s.cutoffEdu : "";
const scTag = (s) => {
  if (s.delta == null) return { t: "供医师判读", c: "na" };
  const lo = (s.direction || "higher_better") === "lower_better";
  if (s.delta === 0) return { t: "处于分界", c: "mid" };
  const good = lo ? s.delta < 0 : s.delta > 0;
  return good ? { t: "参考范围内", c: "ok" } : { t: lo ? "高于参考" : "低于参考", c: "bad" };
};

// 复评前后认知域对比：同一六轴模板叠加首次（灰虚线）与复评（主色实线）两条轮廓
const radarDualModel = (a, b) => {
  const hasA = a && Object.keys(a).length, hasB = b && Object.keys(b).length;
  if (!hasA && !hasB) return null;
  const cx = 170, cy = 150, R = 100;
  const ang = (i) => (-90 + i * 60) * Math.PI / 180;
  const at = (i, k) => ({ x: +(cx + Math.cos(ang(i)) * R * k).toFixed(1), y: +(cy + Math.sin(ang(i)) * R * k).toFixed(1) });
  const series = (r) => {
    const pts = DOMS.map((d, i) => ({ d, i, v: r && r[d] != null ? r[d] : null }))
      .filter(p => p.v != null)
      .map(p => { const q = at(p.i, Math.max(0, Math.min(100, p.v)) / 100); return { d: p.d, i: p.i, v: p.v, x: q.x, y: q.y }; });
    // 只在相邻（序号连续）的两点之间连线，跨未测域不连
    const segs = [];
    for (let k = 0; k + 1 < pts.length; k++) {
      const x = pts[k], y = pts[k + 1];
      if (y.i === x.i + 1) segs.push({ x1: x.x, y1: x.y, x2: y.x, y2: y.y });
    }
    return { pts, segs, full: pts.length >= 3, poly: pts.map(p => p.x + "," + p.y).join(" ") };
  };
  const labels = DOMS.map((d, i) => {
    const c = Math.cos(ang(i));
    return {
      d, lx: +(cx + c * (R + 17)).toFixed(1), ly: +(cy + Math.sin(ang(i)) * (R + 17)).toFixed(1),
      anchor: Math.abs(c) < 0.2 ? "middle" : (c > 0 ? "start" : "end"),
      lit: (a && a[d] != null) || (b && b[d] != null),
    };
  });
  return {
    cx, cy, labels,
    rings: [0.25, 0.5, 0.75, 1].map(k => DOMS.map((_, i) => { const p = at(i, k); return p.x + "," + p.y; }).join(" ")),
    spokes: DOMS.map((_, i) => at(i, 1)),
    base: series(a), cur: series(b),
  };
};

const DomainCompare = {
  props: {
    base: { type: Object, default: null },
    cur: { type: Object, default: null },
    baseLabel: { type: String, default: "基线" },
    curLabel: { type: String, default: "对比" },
  },
  computed: { model() { return radarDualModel(this.base, this.cur); } },
  template: `<div class="rep-body">
    <div class="rep-radar">
      <svg v-if="model" viewBox="0 0 340 300" style="width:100%;max-width:440px;height:auto;overflow:visible" role="img" aria-label="认知域前后对比">
        <polygon v-for="(rg, i) in model.rings" :key="'r' + i" :points="rg" fill="none" stroke="#e9eef3" stroke-width="1" />
        <line v-for="(sp, i) in model.spokes" :key="'s' + i" :x1="model.cx" :y1="model.cy" :x2="sp.x" :y2="sp.y" stroke="#e9eef3" stroke-width="1" />
        <polygon v-if="model.base.full" :points="model.base.poly" fill="rgba(154,169,184,.16)" stroke="#9aa9b8" stroke-width="1.6" stroke-dasharray="5 3" stroke-linejoin="round" />
        <line v-for="(sg, i) in model.base.segs" :key="'bs' + i" :x1="sg.x1" :y1="sg.y1" :x2="sg.x2" :y2="sg.y2" stroke="#9aa9b8" stroke-width="1.6" stroke-dasharray="5 3" />
        <polygon v-if="model.cur.full" :points="model.cur.poly" fill="rgba(14,159,138,.14)" stroke="#0e9f8a" stroke-width="2" stroke-linejoin="round" />
        <line v-for="(sg, i) in model.cur.segs" :key="'cs' + i" :x1="sg.x1" :y1="sg.y1" :x2="sg.x2" :y2="sg.y2" stroke="#0e9f8a" stroke-width="2" stroke-linecap="round" />
        <circle v-for="p in model.base.pts" :key="'bd' + p.d" :cx="p.x" :cy="p.y" r="2.6" fill="#9aa9b8" />
