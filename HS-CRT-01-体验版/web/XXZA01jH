                <span v-html="hsIcon('UI-BRAIN')"></span>全部
              </span>
              <span v-for="d in DOMS" :key="d" class="tp-chip" :class="[DOMKEY[d], { on: domFilter === d }]"
                    @click="domFilter = domFilter === d ? '' : d">
                <span v-html="hsIcon(d)"></span>{{ d }}<em>{{ domCount(d) }}</em>
              </span>
            </div>
            <div class="tp-grid">
              <div class="tp-card" :class="DOMKEY[t.domain]" v-for="t in shownTrainings" :key="t.code"
                   role="button" tabindex="0" :aria-label="'打开 ' + t.name + ' 试玩'"
                   @click="openPreview(t)" @keyup.enter="openPreview(t)" @keyup.space.prevent="openPreview(t)">
                <div class="tp-top">
                  <span class="tp-ico" v-html="hsIcon(t.code)"></span>
                  <span class="tp-id">
                    <span class="tp-code">{{ t.code }} · {{ t.archetype }}</span>
                    <span class="tp-name">{{ t.name }}</span>
                  </span>
                  <span class="tp-lv">{{ (t.levels || []).length }} 关</span>
                </div>
                <div class="tp-meta"><i class="tp-dot"></i><span class="tp-dom">{{ t.domain }}</span></div>
                <div class="tp-desc">{{ t.desc }}</div>
                <div class="tp-foot">
                  <span class="tp-levels"><i v-for="(l, i) in (t.levels || [])" :key="i" :style="{ opacity: 0.32 + i * 0.068 }"></i></span>
                </div>
              </div>
            </div>
          </div>

          <!-- 方案编辑弹窗（标准 / 自定义共用；项目来自全量项） -->
          <el-dialog v-model="libEdit.show" :title="(libEdit.id ? '编辑' : '新建') + '方案'" width="720px">
            <el-form label-width="86px">
              <el-row :gutter="12">
                <el-col :span="24"><el-form-item label="方案类型">
                  <el-radio-group v-model="libEdit.category" :disabled="!!libEdit.id">
                    <el-radio value="standard">标准方案<span class="radio-hint">可修改，不可删除</span></el-radio>
                    <el-radio value="custom">自定义方案<span class="radio-hint">可修改、可删除</span></el-radio>
                  </el-radio-group>
                  <span v-if="libEdit.id" class="radio-hint" style="margin-left:8px">类型创建后不可变更</span>
                </el-form-item></el-col>
                <el-col :span="14"><el-form-item label="方案名称" required><el-input v-model="libEdit.name" placeholder="如：全面评估方案" /></el-form-item></el-col>
                <el-col :span="10"><el-form-item label="预计时长"><el-input-number v-model="libEdit.minutes" :min="5" :max="180" :step="5" style="width:100%" /></el-form-item></el-col>
                <el-col :span="24"><el-form-item label="方案说明"><el-input v-model="libEdit.desc" placeholder="适用场景、注意事项等" /></el-form-item></el-col>
              </el-row>
              <el-form-item label="评估项目" required>
                <div style="border:1px solid var(--c-line);border-radius:10px;padding:12px 14px;width:100%;background:var(--c-surface-2)">
                  <div style="font-size:12px;color:var(--c-text-3);margin-bottom:6px">全量项 · 量表（{{ activeScales.length }}）</div>
                  <el-checkbox-group v-model="libChecked" class="lib-pick">
                    <el-checkbox v-for="s in activeScales" :key="s.code" :value="'scale:' + s.code">
                      <span class="mono" style="font-size:11.5px;color:var(--c-text-3)">{{ s.code }}</span> {{ s.name.replace(/（.*?）/g, "") }}
                    </el-checkbox>
                  </el-checkbox-group>
                  <div style="font-size:12px;color:var(--c-text-3);margin:12px 0 6px">全量项 · 范式（{{ activeParadigms.length }}）</div>
                  <el-checkbox-group v-model="libChecked" class="lib-pick">
                    <el-checkbox v-for="p in activeParadigms" :key="p.code" :value="'paradigm:' + p.code">
                      <span class="mono" style="font-size:11.5px;color:var(--c-text-3)">{{ p.code }}</span> {{ p.name.replace(/（.*?）/g, "") }}
                    </el-checkbox>
                  </el-checkbox-group>
                </div>
              </el-form-item>
              <div style="font-size:12px;color:var(--c-text-3)">已选 <b class="num">{{ libChecked.length }}</b> 项 · 全量项共 {{ activeScales.length + activeParadigms.length }} 项</div>
            </el-form>
            <template #footer>
              <el-button @click="libEdit.show = false">取消</el-button>
              <el-button type="primary" :loading="libEdit.saving" @click="saveLib">保存方案</el-button>
            </template>
          </el-dialog>
        </div>

        <!-- ---------- 训练方案 ---------- -->
        <div v-else-if="view === 'prescribe' && reco">
          <div class="lb-pagehead">
            <div><div class="ph-t">训练方案 · {{ cur.name }}</div>
              <div class="ph-d">{{ cur.sex }} · {{ ageOf(cur.birth_date) }}岁 · {{ cur.education }} · 门诊号 {{ cur.outpatient_no }}</div></div>
            <div class="ph-a"><el-button @click="go('train')">返回</el-button></div>
          </div>

          <el-alert v-if="!reco.ok" type="warning" :closable="false" :title="reco.message" show-icon />
          <div v-else style="display:grid;grid-template-columns:1fr 1fr;gap:14px">
            <!-- 左：患者评估结果（与评估报告同一套渲染） -->
            <div style="display:flex;flex-direction:column;gap:14px">
              <div class="lb-card" style="margin:0;display:flex;flex-direction:column">
                <div class="head"><div class="t">认知域画像 <span class="sub">DSM-5 六域</span><el-tooltip content="认知域画像根据评估结果进行归一化计算绘制，用于认知域整体情况的分析参考。" placement="top"><span class="q-mark">?</span></el-tooltip></div></div>
                <domain-profile :model="prRadarModel" :doms="prDomains" />
              </div>

              <div class="lb-card" style="margin:0">
                <div class="head"><div class="t">评估项目结果 <span class="sub">最近一次已完成评估{{ reco.at ? ' · ' + reco.at : '' }}</span></div></div>
                <project-result :chart="reco.chart || []" />
              </div>
            </div>

            <!-- 右：系统推荐与方案清单 -->
            <div style="display:flex;flex-direction:column;gap:14px">
              <div class="lb-card" style="margin:0">
                <div class="head"><div class="t">系统推荐训练方案 <span class="sub">按各认知域受损程度匹配</span></div></div>
                <el-table :data="reco.plans" size="small" max-height="300" empty-text="暂无推荐">
                  <el-table-column prop="domain" label="认知域" min-width="110" align="center" />
                  <el-table-column prop="program" label="方案" min-width="88" align="center" />
                  <el-table-column prop="name" label="名称" min-width="100" align="center" />
                  <el-table-column prop="start" label="建议起始关" min-width="96" align="center" />
                  <el-table-column label="操作" width="72" align="center"><template #default="s"><el-button size="small" text type="primary" :disabled="!!prPlanId" @click="addPlan(s.row)">加入</el-button></template></el-table-column>
                </el-table>
              </div>

              <div class="lb-card" style="margin:0">
                <div class="head"><div class="t">训练方案生成</div>
                  <div style="display:flex;align-items:center;gap:8px">
                    <el-button v-if="activePlan" size="small" type="warning" plain @click="stopActivePlan">终止方案</el-button>
                    <el-button size="small" :disabled="!!prPlanId" @click="openTrainPick"><el-icon style="margin-right:4px"><Plus /></el-icon>手动添加</el-button>
                  </div>
                </div>
                <div v-if="activePlan" style="margin:-6px 0 10px;display:flex;align-items:center;gap:8px">
                  <span class="st-chip run">生成时间 {{ (activePlan.pushed_at || activePlan.created_at || "").slice(0, 16) }} · 已锁定</span>
                </div>
                <el-table :data="basket" size="small" max-height="300" empty-text="尚未加入方案，可从上方推荐「加入」或「手动添加」">
                  <el-table-column type="index" label="序号" width="60" align="center" />
                  <el-table-column prop="domain" label="认知域" min-width="100" align="center" />
                  <el-table-column prop="program" label="方案" min-width="90" align="center" />
                  <el-table-column prop="name" label="名称" min-width="110" align="center" />
                  <el-table-column label="起始关" min-width="104" align="center"><template #default="s"><el-input-number v-model="s.row.startLevel" :min="1" :max="10" size="small" style="width:96px" :disabled="!!prPlanId" /></template></el-table-column>
                  <el-table-column label="操作" width="70" align="center"><template #default="s"><el-button size="small" text type="danger" :disabled="!!prPlanId" @click="removeBasket(s.row)">移除</el-button></template></el-table-column>
                </el-table>
                <el-form label-width="86px" style="margin-top:14px">
                  <el-row :gutter="10">
                    <el-col :span="12"><el-form-item label="训练项">
                      <el-select :model-value="prForm.items" style="width:100%" :disabled="!!prPlanId" @change="applyTrainItems">
                        <el-option v-for="n in trainItemOptions" :key="n" :value="n" :label="n + ' 项'" />
                      </el-select>
                    </el-form-item></el-col>
                    <el-col :span="12"><el-form-item label="单次时长"><el-select v-model="prForm.minutes" style="width:100%" :disabled="!!prPlanId"><el-option :value="20" label="20 分钟" /><el-option :value="30" label="30 分钟" /></el-select></el-form-item></el-col>
                    <el-col :span="12"><el-form-item label="每周频次"><el-select v-model="prForm.freq" style="width:100%" :disabled="!!prPlanId"><el-option v-for="n in [3,4,5]" :key="n" :value="n" :label="n + ' 次'" /></el-select></el-form-item></el-col>
                    <el-col :span="12"><el-form-item label="疗程"><el-select v-model="prForm.weeks" style="width:100%" :disabled="!!prPlanId"><el-option v-for="n in [8,10,12]" :key="n" :value="n" :label="n + ' 周'" /></el-select></el-form-item></el-col>
                    <el-col :span="12"><el-form-item label="难度策略"><el-switch v-model="prForm.locked" active-text="锁定" inactive-text="自适应" :disabled="!!prPlanId" /></el-form-item></el-col>
                  </el-row>
                </el-form>
                <div style="display:flex;gap:10px">
                  <el-button type="primary" style="flex:1" :loading="prSaving" :disabled="!!prPlanId" @click="savePlan">{{ prPlanId ? "方案进行中" : "生成训练方案" }}</el-button>
                </div>
              </div>
            </div>
          </div>
        </div>

        <!-- ---------- 数据记录（评估 / 训练 / 依从性 / 训练效果） ---------- -->
        <div v-else-if="view === 'records'">
          <!-- 患者：可搜索更多患者，选中后展示基础信息 -->
          <div class="lb-card rec-pick">
            <div class="rp-left">
              <template v-if="recPatient">
                <span class="rp-name">{{ recPatient.name }}</span>
                <span class="rp-no mono">{{ rec ? rec.patient.outpatient_no : "" }}</span>
              </template>
              <span v-else class="rp-no">未选择</span>
            </div>
            <div class="rp-mid" v-if="rec">
              <span class="dom-tag">{{ rec.patient.sex }} · {{ rec.patient.age }}岁</span>
              <span class="dom-tag">{{ rec.patient.education }}</span>
              <span class="dom-tag">{{ rec.patient.dept }}</span>
              <span class="dom-tag">建档 {{ (rec.patient.created_at || "").slice(0, 10) || "—" }}</span>
            </div>
            <div v-else class="rp-mid"></div>
            <el-button @click="openRecPick">选择患者</el-button>
            <el-button @click="loadRecords" :loading="recLoading">刷新</el-button>
          </div>

          <template v-if="rec">
            <!-- 四个数据块：点击切换下方内容 -->
            <div class="rec-blocks">
              <div class="rec-blk" :class="{ on: recBlock === 'assess' }" @click="recBlock = 'assess'">
                <div class="rb-k"><i class="dot"></i>评估记录</div>
                <div class="rb-v">{{ rec.assess.length }}<small>次</small></div>
              </div>
              <div class="rec-blk blue" :class="{ on: recBlock === 'train' }" @click="recBlock = 'train'">
                <div class="rb-k"><i class="dot"></i>训练记录</div>
                <div class="rb-v">{{ rec.summary.sessions }}<small>次</small></div>
              </div>
              <div class="rec-blk ok" :class="{ on: recBlock === 'adhere' }" @click="recBlock = 'adhere'">
                <div class="rb-k"><i class="dot"></i>依从性</div>
                <div class="rb-v">{{ recAdhStats ? recAdhStats.rate : 0 }}<small>% 完成率</small></div>
              </div>
              <div class="rec-blk warn" :class="{ on: recBlock === 'review' }" @click="recBlock = 'review'">
                <div class="rb-k"><i class="dot"></i>训练效果</div>
                <div class="rb-v" v-if="recReview">{{ recReview.avg == null ? "—" : (recReview.avg > 0 ? "+" : "") + recReview.avg }}<small v-if="recReview.avg != null">分</small></div>
                <div class="rb-v" v-else>—</div>
              </div>
            </div>

            <!-- ========== 评估记录：历次评估 + 切换查看报告 ========== -->
            <div class="lb-card rec-pane" v-show="recBlock === 'assess'">
              <div class="mini-h">历次评估</div>
              <div class="rec-assess-list">
                <div v-for="(a, i) in rec.assess" :key="a.id" class="ra-row"
                     :class="{ on: a.id === recAssessId, pending: !a.report_id }" @click="pickAssess(a)">
                  <div class="ra-idx">{{ rec.assess.length - i }}</div>
                  <div class="ra-main">
                    <div class="ra-t">
                      <span class="ra-plan">{{ a.plan_name }}</span>
                      <el-tag size="small" :type="a.status === '已完成' ? 'success' : 'warning'" effect="light">{{ a.status }}</el-tag>
                    </div>
                    <div class="ra-s">
                      <span class="mono">{{ (a.started_at || "").slice(0, 16) }}</span>
                      <span class="ra-sep">·</span>
                      <span class="mono">{{ a.report_no || "报告待生成" }}</span>
                    </div>
                  </div>
                  <div class="ra-prog">
                    <div class="ra-prog-t">项目完成 <b class="mono">{{ a.done }}/{{ a.total }}</b></div>
                    <el-progress :percentage="a.total ? Math.round(a.done / a.total * 100) : 0" :stroke-width="6" :show-text="false" />
                  </div>
                  <i class="ra-chev"></i>
                </div>
              </div>

              <template v-if="recRep">
                <div class="rec-rep-hd">
                  <div class="mini-h">第 {{ recAssessIdx }} 次评估报告 <span>{{ recRep.report_no }} · {{ recRep.created_at }}</span></div>
                </div>
                <div class="rec-rep-grid">
                  <div><project-result :chart="recRep.chart || []" /></div>
                  <div><domain-profile :model="recRepRadar" :doms="recRepDoms" /></div>
                </div>
              </template>
              <el-empty v-else :description="recAssessCur && !recAssessCur.report_id ? '该次评估尚未生成报告，评分提交后自动生成' : '暂无评估报告'" :image-size="70" />
            </div>

            <!-- ========== 训练记录：历次训练方案 + 成绩/认知域/完成情况/明细 ========== -->
            <div class="lb-card rec-pane" v-show="recBlock === 'train'">
              <div class="mini-h">历次训练方案</div>
              <div class="pchip-row">
                <div class="pchip" v-for="(p, i) in rec.plans" :key="p.id" :class="{ on: p.id === recPlanId }" @click="pickPlan(p)">
                  <div class="ra-idx">{{ rec.plans.length - i }}</div>
                  <div class="pc-b">
                    <div class="pc-t">
                      <span class="st-chip" :class="stClass(p.status)">{{ p.status }}</span>
                      <span class="pc-n">{{ p.itemsCount }} 项 · {{ p.minutes }} 分钟</span>
                    </div>
                    <div class="pc-m">{{ p.freq }} 次/周 × {{ p.weeks }} 周 · {{ (p.startAt || "").slice(5) }} 起 · {{ p.doneSessions }}/{{ p.expectSessions }} 次</div>
                  </div>
                </div>
                <div v-if="!rec.plans.length" class="st-none" style="padding:8px 0">暂无训练方案</div>
              </div>

              <el-radio-group v-model="recTrainView" size="small" style="margin:2px 0 10px" v-if="recPlan">
                <el-radio-button value="trend">训练成绩趋势</el-radio-button>
                <el-radio-button value="domain">训练认知域</el-radio-button>
                <el-radio-button value="progress">训练完成情况</el-radio-button>
                <el-radio-button value="detail">训练明细</el-radio-button>
              </el-radio-group>

              <div v-if="recTrainView === 'trend'">
                <template v-if="recPlan && recPlan.progs.length">
                  <div class="mini-h">各方案成绩趋势 <span>正确率 / 逐次</span></div>
                  <div ref="recLine" style="height:270px"></div>
                </template>
                <el-empty v-else description="该方案暂无训练记录" :image-size="70" />
              </div>

              <div v-else-if="recTrainView === 'domain'">
                <div v-if="recPlan && recPlan.domains.length" style="display:grid;grid-template-columns:1fr 1fr;gap:16px">
                  <div>
                    <div class="mini-h">认知域训练分布 <span>次数 / 覆盖方案</span></div>
                    <div ref="recDom" :style="{ height: Math.min(320, 70 + recPlan.domains.length * 42) + 'px' }"></div>
                  </div>
                  <div>
                    <div class="mini-h">认知域明细</div>
                    <el-table :data="recPlan.domains" size="small">
                      <el-table-column prop="domain" label="认知域" min-width="100" align="center" />
                      <el-table-column label="训练次数" min-width="80" align="center"><template #default="s"><span class="mono">{{ s.row.sessions }}</span></template></el-table-column>
                      <el-table-column label="覆盖方案" min-width="80" align="center"><template #default="s"><span class="mono">{{ s.row.programs }}</span></template></el-table-column>
                      <el-table-column label="平均正确率" min-width="90" align="center"><template #default="s"><span class="mono">{{ s.row.avgAcc }}%</span></template></el-table-column>
                      <el-table-column label="最高关卡" min-width="80" align="center"><template #default="s"><span class="mono">L{{ s.row.maxLevel }}</span></template></el-table-column>
                    </el-table>
                  </div>
                </div>
                <el-empty v-else description="该方案暂无训练记录" :image-size="70" />
              </div>

              <div v-else-if="recTrainView === 'progress'">
                <template v-if="recPlan">
                  <div class="mini-h">训练完成情况 <span>项目 / 关卡进度 / 成绩</span></div>
                  <el-table :data="recPlan.progs" size="small">
                    <el-table-column label="训练项目" min-width="110">
                      <template #default="s">
                        <span style="display:inline-flex;align-items:center;gap:7px">
                          <span class="ico-box" :style="{ background: DOMBG[s.row.domain], color: DOMFG[s.row.domain] }" v-html="hsIcon(s.row.program)"></span>
                          <span><b style="font-size:13px">{{ s.row.name }}</b><br><span class="mono" style="font-size:10.5px;color:var(--c-text-3)">{{ s.row.program }}</span></span>
                        </span>
                      </template>
                    </el-table-column>
                    <el-table-column prop="domain" label="认知域" min-width="100" align="center" />
                    <el-table-column label="关卡进度" min-width="110" align="center">
                      <template #default="s">
                        <div>
                          <el-progress :percentage="Math.round(s.row.curLevel / 10 * 100)" :stroke-width="6" :show-text="false" />
                          <span class="mono" style="display:block;margin-top:4px;font-size:11px;color:var(--c-text-3)">{{ s.row.curLevel }}/10 · 最高 {{ s.row.maxLevel }}</span>
                        </div>
                      </template>
                    </el-table-column>
                    <el-table-column label="训练次数" min-width="80" align="center"><template #default="s"><span class="mono">{{ s.row.sessions }}</span></template></el-table-column>
                    <el-table-column label="平均正确率" min-width="90" align="center">
                      <template #default="s"><span class="mono" :style="{ color: s.row.avgAcc >= 80 ? 'var(--c-success)' : 'var(--c-warning)' }">{{ s.row.avgAcc }}%</span></template>
                    </el-table-column>
                    <el-table-column label="累计用时" min-width="80" align="center"><template #default="s"><span class="mono">{{ s.row.minutes }} 分</span></template></el-table-column>
                    <el-table-column label="最近训练" min-width="100" align="center"><template #default="s"><span class="mono" style="font-size:11.5px">{{ (s.row.lastAt || "").slice(5, 16) }}</span></template></el-table-column>
                  </el-table>

                  <div class="mini-h" style="margin-top:14px">方案执行进度 <span>已完成 {{ recPlan.doneSessions }} 次 / 应训练 {{ recPlan.expectSessions }} 次</span></div>
                  <div class="plan-exec">
                    <el-progress :percentage="recPlan.progress" :stroke-width="10" />
                    <div class="pe-meta">
                      <span>训练项 {{ recPlan.itemsCount }} 项</span>
                      <span>剂量 {{ recPlan.minutes }} 分钟 × {{ recPlan.freq }} 次/周 × {{ recPlan.weeks }} 周</span>
                      <span>周期 {{ recPlan.startAt }} ~ {{ recPlan.endAt }}</span>
                      <span>难度 {{ recPlan.locked ? "医生锁定" : "自适应" }}</span>
                    </div>
                  </div>
                </template>
                <el-empty v-else description="暂无训练方案" :image-size="70" />
              </div>

              <div v-else>
                <div style="display:flex;align-items:center;gap:10px;margin-bottom:10px">
                  <span style="font-size:12.5px;color:var(--c-text-3)">共 {{ rec.records.total }} 条记录</span>
