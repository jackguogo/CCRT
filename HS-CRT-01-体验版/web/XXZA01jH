        } catch (e) { return msg.error(e.message); }
      }
      if (openRunWindow(runRec.value)) started.value = true;
    };
    const closeRunWindow = () => { window.close(); setTimeout(() => { if (!window.closed) go("assess"); }, 120); };
    const assessList = ref([]);
    const loadAssessList = async () => { try { assessList.value = await api("/assessments"); } catch (e) { /* 治疗师无权限时忽略 */ } };
    const assessRunning = computed(() => assessList.value.filter(a => a.status === "进行中"));
    const assessDone = computed(() => assessList.value.filter(a => a.status === "已完成"));
    const assessVoided = computed(() => assessList.value.filter(a => a.status === "已作废"));
    // 进行中 / 已完成 / 已作废 共用一个列表区域，用切换按钮换数据源；三套分页状态各自独立记忆
    const assessTab = ref("running");
    const aPager = reactive({
      running: { page: 1, size: 10 },
