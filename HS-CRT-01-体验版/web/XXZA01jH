          const d = await api("/assessments", { method: "POST", body: { patientId: ap.pid, planName: ap.custom ? customName.value : (pl ? pl.name : "评估方案"), planId: ap.custom ? 0 : (pl ? pl.id : 0), items: ap.items, mode: "doctor" } });
