    const radarSvg = (r, opts) => {
      if (!r) return null;
      const showVal = !opts || opts.showVal !== false;
      const cx = 170, cy = 150, R = 100;
      const ang = (i) => (-90 + i * 60) * Math.PI / 180;
      const at = (i, k) => ({ x: +(cx + Math.cos(ang(i)) * R * k).toFixed(1), y: +(cy + Math.sin(ang(i)) * R * k).toFixed(1) });
      const pts = DOMS.map((d, i) => {
        const v = r[d];
        const lit = v != null;
        const p = at(i, lit ? Math.max(0, Math.min(100, v)) / 100 : 0);
        const a = at(i, 1);
        const c = Math.cos(ang(i));
        return {
          d, v, lit, x: p.x, y: p.y, ax: a.x, ay: a.y,
          txt: lit && showVal ? d + " " + v : d,
          lx: +(cx + c * (R + 17)).toFixed(1), ly: +(cy + Math.sin(ang(i)) * (R + 17)).toFixed(1),
          anchor: Math.abs(c) < 0.2 ? "middle" : (c > 0 ? "start" : "end"),
        };
      });
      const lit = pts.filter(p => p.lit);
      // 只在相邻且都实测的两点之间连线，避免跨越未测域造成误读；实测域 ≥3 个即连成闭合区域
      const segs = [];
      for (let i = 0; i < 6; i++) {
        const a = pts[i], b = pts[(i + 1) % 6];
        if (a.lit && b.lit) segs.push({ x1: a.x, y1: a.y, x2: b.x, y2: b.y });
      }
      return {
        cx, cy, R, pts, lit, segs, full: lit.length >= 3,
        rings: [0.25, 0.5, 0.75, 1].map(k => DOMS.map((_, i) => { const p = at(i, k); return `${p.x},${p.y}`; }).join(" ")),
        spokes: DOMS.map((_, i) => at(i, 1)),
        poly: lit.map(p => `${p.x},${p.y}`).join(" "),
