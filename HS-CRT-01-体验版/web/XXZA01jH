          </div>
          <div v-else class="qx-sec qx-scoring">
            <div class="qx-lb qx-score-hd"><span>本题评分</span><b>{{ curQuizScoreText }}</b></div>
            <div class="qx-bands">
              <button v-for="b in curQuizBands" :key="b[0]" type="button" class="qx-band"
                      :class="{ on: curQuizScore === Number(b[0]) }" @click="setQuizScore(b[0])">
