        <text v-for="l in model.labels" :key="'l' + l.d" :x="l.lx" :y="l.ly" :text-anchor="l.anchor" dominant-baseline="central" font-size="10.5" :fill="l.lit ? '#5a6b7b' : '#b4b2a9'">{{ l.d }}</text>
      </svg>
      <el-empty v-else description="两次评估均未包含认知域范式" :image-size="80" />
    </div>
    <div class="cmp-legend"><span><i style="background:#9aa9b8"></i>{{ baseLabel }}</span><span><i style="background:#0e9f8a"></i>{{ curLabel }}</span></div>
  </div>`,
};

// 认知域画像：六轴雷达（轴标签不带分值）+ 下方六域百分比条，报告与训练方案共用
const DomainProfile = {
  props: {
    model: { type: Object, default: null },
    doms: { type: Array, default: () => [] },
    empty: { type: String, default: "本次评估未包含认知域范式，不生成认知域画像" },
  },
  template: `<div class="rep-body">
    <div class="rep-radar">
      <template v-if="model">
        <svg viewBox="0 0 340 300" style="width:100%;max-width:440px;height:auto;overflow:visible" role="img" aria-label="认知域画像">
          <polygon v-for="(rg, i) in model.rings" :key="'ring' + i" :points="rg" fill="none" stroke="#e9eef3" stroke-width="1" />
          <line v-for="(sp, i) in model.spokes" :key="'sp' + i" :x1="model.cx" :y1="model.cy" :x2="sp.x" :y2="sp.y" stroke="#e9eef3" stroke-width="1" />
          <polygon v-if="model.full" :points="model.poly" fill="rgba(14,159,138,.14)" stroke="#0e9f8a" stroke-width="2" stroke-linejoin="round" />
          <line v-for="(sg, i) in model.segs" :key="'seg' + i" :x1="sg.x1" :y1="sg.y1" :x2="sg.x2" :y2="sg.y2" stroke="#0e9f8a" stroke-width="2" stroke-linecap="round" />
          <circle v-for="p in model.lit" :key="'dot' + p.d" :cx="p.x" :cy="p.y" r="3.4" fill="#0e9f8a" />
          <g v-for="p in model.pts" :key="'lb' + p.d">
            <text v-if="p.lit" :x="p.lx" :y="p.ly" :text-anchor="p.anchor" dominant-baseline="central" font-size="10.5" fill="#5a6b7b">{{ p.txt }}</text>
            <template v-else>
              <text :x="p.lx" :y="p.ly - 6" :text-anchor="p.anchor" dominant-baseline="central" font-size="10.5" fill="#b4b2a9">{{ p.d }}</text>
              <text :x="p.lx" :y="p.ly + 7" :text-anchor="p.anchor" dominant-baseline="central" font-size="10" fill="#c9c7bf">未测</text>
            </template>
          </g>
        </svg>
      </template>
      <el-empty v-else :description="empty" :image-size="80" />
    </div>
    <div v-if="model" class="rep-doms">
      <div class="rd-row" v-for="x in doms" :key="x.d">
        <span class="rd-k">{{ x.d }}</span>
        <span v-if="x.v != null" class="rd-v num">{{ x.v }}<i>%</i></span>
        <span v-else class="rd-v na">未测</span>
        <span class="rd-track"><i :class="{ na: x.v == null }" :style="{ width: (x.v != null ? x.v : 0) + '%' }"></i></span>
      </div>
    </div>
  </div>`,
};

// 各项目完成情况：量表（分值色条 + 参考区间 + 判定）/ 范式（按各自身指标成组），报告与训练方案共用
const ProjectResult = {
  props: {
    chart: { type: Array, default: () => [] },
    scaleSub: { type: String, default: "实际得分与参考区间" },
    paradigmSub: { type: String, default: "各范式按自身指标记录" },
  },
  computed: {
    scales() { return (this.chart || []).filter(c => c.kind === "scale"); },
    paradigms() { return (this.chart || []).filter(c => c.kind === "paradigm"); },
  },
  methods: { pctOf, barStyle, rangeMain, rangeEdu, scTag },
  template: `<div>
    <div class="rep-sub">量表评定 <span>{{ scaleSub }}</span></div>
    <div v-if="scales.length">
      <div class="sc-card" v-for="s in scales" :key="s.name">
        <div class="sc-hd">
          <span class="sc-name">{{ s.name }}</span>
          <span class="sc-val"><b class="num">{{ s.total != null ? s.total : "—" }}</b> 分</span>
        </div>
        <div class="sc-bar">
          <div class="sc-track" :style="barStyle(s)"></div>
          <div v-if="s.cutoff != null" class="sc-cut" :style="{ left: pctOf(s.cutoff, s.max) }"></div>
        </div>
        <div class="sc-ft">
          <span class="sc-range">{{ rangeMain(s) }}<template v-if="rangeEdu(s)"><i class="sc-edu">{{ rangeEdu(s) }}</i></template><template v-if="s.cutoff != null">）</template></span>
          <span class="sc-mid">总分: {{ s.max }}</span>
          <span class="sc-cur">当前: {{ s.total != null ? s.total : "—" }}</span>
        </div>
        <div class="sc-tagrow">
          <span class="sc-tag" :class="scTag(s).c">{{ scTag(s).t }}</span>
        </div>
      </div>
    </div>
    <div v-else class="st-none" style="padding:6px 0 10px">本次评估未包含量表</div>

    <div class="rep-sub" style="margin-top:14px">范式评估 <span>{{ paradigmSub }}</span></div>
    <div v-if="paradigms.length" class="pf-grid">
      <div class="pf-card" v-for="m in paradigms" :key="m.name">
        <div class="pf-hd">
          <span class="pf-name">{{ m.name }}</span>
          <span v-if="m.domain" class="pf-dom">{{ m.domain }}</span>
        </div>
        <div class="pf-items">
          <div class="pf-item" v-for="x in m.metrics" :key="x.k">
            <span class="pf-k">{{ x.k }}</span>
            <span class="pf-v num">{{ x.v }}</span>
          </div>
        </div>
      </div>
    </div>
    <div v-else class="st-none" style="padding:6px 0">本次评估未包含范式</div>
  </div>`,
};

// 流程路径：选择评估方案 → 患者身份核对 → 评估施测 → 评分提交
const FlowPath = {
  props: { step: { type: Number, default: 1 } },
  template: `<div class="flow-path">
    <div class="fp-step" :class="{ on: step >= 1 }"><span class="fp-dot">1</span><span class="fp-t">选择评估方案</span></div>
    <span class="fp-line"></span>
    <div class="fp-step" :class="{ on: step >= 2 }"><span class="fp-dot">2</span><span class="fp-t">患者身份核对</span></div>
    <span class="fp-line"></span>
    <div class="fp-step" :class="{ on: step >= 3 }"><span class="fp-dot">3</span><span class="fp-t">评估</span></div>
    <span class="fp-line"></span>
    <div class="fp-step" :class="{ on: step >= 4 }"><span class="fp-dot">4</span><span class="fp-t">评分提交</span></div>
  </div>`
};

const app = createApp(App);
app.component("flow-path", FlowPath);
app.component("domain-profile", DomainProfile);
app.component("domain-compare", DomainCompare);
app.component("project-result", ProjectResult);
app.use(ElementPlus, { locale: ElementPlusLocaleZhCn });
for (const [k, c] of Object.entries(ElementPlusIconsVue)) app.component(k, c);
app.config.globalProperties.window = window;
app.mount("#app");
</script></body></html>
