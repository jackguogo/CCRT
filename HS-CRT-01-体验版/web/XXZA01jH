    };
    const started = ref(false);
    // 身份确认：只推进到「开始评估」步骤，评估记录在点击「开始评估」时才创建
    const confirmStart = () => {
      if (!ap.identityOk) return msg.warning("请勾选确认：已当面核对患者身份信息");
