                     placeholder="选择或填写作废原因" style="width:100%">
            <el-option v-for="r in CANCEL_REASONS" :key="r" :label="r" :value="r" />
          </el-select>
          <template #footer>
            <el-button @click="cx.show = false">取消</el-button>
            <el-button type="danger" :loading="cx.saving" @click="doCancel">确认作废</el-button>
          </template>
        </el-dialog>

        <!-- ---------- 训练方案效果测试（静态训练页，本地模拟结算，不写库） ---------- -->
        <el-dialog v-model="preview.show" width="1080px" top="5vh" class="tp-dialog" destroy-on-close @closed="closePreview">
          <template #header>
            <div class="tp-dlg-hd">
              <span class="tp-ico" :class="DOMKEY[preview.domain]" v-html="hsIcon(preview.code)"></span>
              <div>
                <div class="tp-dlg-t">{{ preview.name }}</div>
                <div class="tp-dlg-c">{{ preview.code }} · {{ preview.domain }} · {{ (preview.levels || []).length }} 级难度</div>
              </div>
              <span class="tp-badge"><span v-html="hsIcon('UI-PLAY')"></span>效果测试 · 不计入训练记录</span>
            </div>
          </template>
          <div class="tp-preview" :class="DOMKEY[preview.domain]">
            <div class="tp-side">
              <div class="blk"><h4>认知域</h4><div class="val">{{ preview.domain }}</div></div>
              <div class="blk"><h4>训练范式</h4><div class="val">{{ preview.archetype || "—" }}</div></div>
              <div class="blk"><h4>方案说明</h4><div class="muted">{{ preview.desc }}</div></div>
              <div class="blk">
                <h4>难度梯度</h4>
                <div class="tp-slevels"><i v-for="(l, i) in (preview.levels || [])" :key="i" :style="{ opacity: 0.3 + i * 0.07 }"></i></div>
                <div class="tp-slevels-lb"><span>L1</span><span>L{{ (preview.levels || []).length }}</span></div>
              </div>
              <div class="blk">
                <h4>剂量建议</h4>
                <div class="dose">单次 20–30 分钟<br>每周 3–5 次<br>疗程 8–12 周</div>
              </div>
            </div>
            <div class="tp-stage">
              <iframe id="tpFrame" v-if="preview.show" :key="preview.code"
                      :src="'/train/' + preview.code + '.html?preview=1'"
                      @load="onPreviewFrame" title="训练方案效果测试"></iframe>
            </div>
          </div>
          <template #footer>
            <span class="tip" style="font-size:11.5px;color:var(--c-text-3)">效果测试 · 不计入训练记录</span>
            <el-button @click="preview.show = false">关闭</el-button>
          </template>
        </el-dialog>

        <!-- ---------- 患者登录码（家庭训练） ---------- -->
        <el-dialog v-model="tkDlg.show" title="患者登录码" width="420px">
          <div v-if="tkDlg.loading" style="text-align:center;padding:36px 0;color:var(--c-text-3);font-size:13px">正在生成…</div>
          <div v-else-if="tkDlg.err" style="padding:10px 0;color:var(--c-danger);font-size:13px">{{ tkDlg.err }}</div>
          <div v-else style="text-align:center">
            <div id="tkQr" style="display:inline-block;padding:10px;background:#fff;border:1px solid var(--c-line);border-radius:10px"></div>
            <div style="margin-top:12px;font-size:13px;color:var(--c-text-2)">任务账号 <b class="mono">{{ tkDlg.account }}</b></div>
            <div style="margin-top:4px;font-size:12px;color:var(--c-text-3)">有效期至 {{ (tkDlg.expires || '').slice(11, 16) }}，仅可使用一次</div>
          </div>
          <el-alert type="info" :closable="false" style="margin-top:12px"
            title="患者用手机扫码即可进入训练；过期请重新生成。在家训练时也可用任务账号与密码登录。" />
          <template #footer>
            <el-button @click="tkDlg.show = false">关闭</el-button>
            <el-button type="primary" :loading="tkDlg.loading" @click="openTicket(cur)">重新生成</el-button>
          </template>
        </el-dialog>

        <!-- ---------- 家属代操作账号 ---------- -->
        <el-dialog v-model="famDlg.show" :title="'家属代操作 · ' + famDlg.pname" width="760px">
          <el-table :data="famDlg.rows" style="width:100%">
            <el-table-column prop="real_name" label="姓名" min-width="100" align="center" />
            <el-table-column prop="dept" label="关系" min-width="90" align="center" />
            <el-table-column prop="phone" label="手机" min-width="120" align="center" />
            <el-table-column prop="username" label="账号" min-width="150" align="center" />
            <el-table-column label="状态" min-width="80" align="center">
              <template #default="s"><el-tag size="small" :type="s.row.status ? 'success' : 'info'" effect="light">{{ s.row.status ? '启用' : '停用' }}</el-tag></template>
            </el-table-column>
            <el-table-column label="操作" width="260" align="center">
              <template #default="s">
                <el-button size="small" plain @click="toggleFamily(s.row)">{{ s.row.status ? '停用' : '启用' }}</el-button>
                <el-button size="small" plain @click="resetFamilyPwd(s.row)">重置密码</el-button>
                <el-button size="small" plain @click="removeFamily(s.row)">解除</el-button>
              </template>
            </el-table-column>
          </el-table>
          <div style="display:flex;gap:8px;margin-top:14px;align-items:center">
            <el-input v-model="famForm.real_name" placeholder="家属姓名" style="width:140px" />
            <el-input v-model="famForm.relation" placeholder="关系，如女儿" style="width:130px" />
            <el-input v-model="famForm.phone" placeholder="手机号" style="width:150px" />
            <el-button type="primary" :loading="famDlg.saving" @click="addFamily">添加</el-button>
          </div>
          <el-alert type="info" :closable="false" style="margin-top:10px"
            title="家属账号仅能操作该患者的训练任务，看不到其他患者；初始密码 123456，首次登录后请修改。" />
        </el-dialog>

      </el-main>
    </el-container>

    <!-- ---------- 患者施测界面（全屏，逐题作答，不显示流程/分值/评分/计分/判分） ---------- -->
    <div v-if="quiz.on && curQuizItem" class="quiz-mask" :class="{ 'quiz-examiner': isExaminer }">
      <div class="quiz-top">
        <div v-if="!isExaminer" class="quiz-prog"><i :style="{ width: quizProgress + '%' }"></i></div>
        <div v-else class="qx-proj">
          <span class="qx-pj">{{ quizProjectName }}</span>
          <span class="qx-pj-n">第 {{ quiz.idx + 1 }} / {{ quizItems.length }} 题</span>
        </div>
        <button v-if="!isExaminer" class="quiz-tipbtn" :class="{ on: quiz.tip }" @click="quiz.tip = !quiz.tip">主试提示</button>
        <button class="quiz-sound" @click="speakCurrent" title="朗读指导语">
          <span class="qs-ic" v-html="hsIcon('UI-SOUND', 16)"></span> 再听一遍
        </button>
        <button class="quiz-sound quiz-mute" :class="{ off: !sound.on }" @click="toggleSound"
                :title="sound.on ? '关闭朗读声音' : '开启朗读声音'" :aria-pressed="sound.on">
          <span class="qs-ic" v-html="hsIcon(sound.on ? 'UI-SOUND' : 'UI-MUTE', 17)"></span>
        </button>
        <button class="quiz-quit" @click="quitQuiz" title="结束">✕</button>
      </div>

      <!-- 主试口述量表：左侧只呈现指导语，右侧为主试操作说明与逐题评分 -->
