        <div class="qx-stage">
          <div class="qx-body">
            <div class="qx-say" :class="{ 'qx-say-sm': curWordList || curNaming || curQuizUnits.length }">{{ curQuizSay }}</div>
            <div v-if="curQuizUnits.length" class="qx-units">
              <div class="qu-hd">作答单元<span>按序逐条念读 · 每条只读一次</span></div>
              <ol class="qu-list">
                <li v-for="(u, ui) in curQuizUnits" :key="ui">
                  <i>{{ ui + 1 }}</i><span>{{ u }}</span>
                </li>
              </ol>
            </div>
            <div v-if="curNaming" class="qx-names">
              <div class="qn-hd">
                <span class="qw-lb">命名清单</span>
                <span class="qn-tip">共 {{ curNaming.all.length }} 项 · 请勾选命名正确的项</span>
              </div>
              <div v-for="(g, gi) in curNaming.groups" :key="gi" class="qn-group">
                <div class="qw-gt">{{ g.t }}</div>
                <div class="qn-grid">
                  <button v-for="it2 in g.items" :key="it2.k" type="button" class="qw-word"
                          :class="{ on: !!namingState.marks[it2.k] }" @click="toggleNaming(it2.k)">
                    <i class="qw-box"></i><span>{{ it2.l }}</span>
                  </button>
                </div>
              </div>
            </div>
            <div v-if="curWordList" class="qx-words">
              <div class="qw-hd">
                <span class="qw-lb">词表</span>
                <div class="qw-sets">
                  <button v-for="(s, i) in curWordList.sets" :key="i" type="button" class="qw-set"
                          :class="{ on: wordState.set === i }" @click="pickWordSet(i)">{{ s.name }}</button>
                </div>
              </div>
              <div v-if="isTrialList" class="qw-trials">
                <button v-for="(g, gi) in wordSet.groups" :key="gi" type="button" class="qw-trial"
                        :class="{ on: wordTrialIdx === gi }" @click="wordState.trial = gi">{{ g.t }}</button>
              </div>
              <div v-for="gi in shownGroups" :key="gi" class="qw-group">
                <div v-if="!isTrialList" class="qw-gt">{{ wordSet.groups[gi].t }}</div>
                <div class="qw-grid">
                  <button v-for="w in wordSet.groups[gi].words" :key="w" type="button" class="qw-word"
                          :class="{ on: wordHit(gi, w) }" @click="toggleWord(gi, w)">
                    <i class="qw-box"></i><span>{{ w }}</span>
                  </button>
                </div>
              </div>
            </div>
            <div v-if="curQuizItem.figure === 'pentagons'" class="qx-fig">
              <svg viewBox="0 0 290 133" width="360" height="165">
                <polygon points="105,14 160,54 139,119 71,119 50,54" fill="none" stroke="#0f172a" stroke-width="2.4" />
                <polygon points="185,14 240,54 219,119 151,119 130,54" fill="none" stroke="#0f172a" stroke-width="2.4" />
              </svg>
            </div>
            <div v-else-if="curQuizItem.figure === 'mocaPath'" class="qx-fig">
              <svg viewBox="0 0 360 320" width="540" height="480">
                <defs>
                  <marker id="mocaArrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
                    <path d="M0 1L10 5L0 9z" fill="#0f172a" />
                  </marker>
                </defs>
                <line v-for="(a, i) in MOCA_ARROWS" :key="'ar' + i" :x1="a[0]" :y1="a[1]" :x2="a[2]" :y2="a[3]"
