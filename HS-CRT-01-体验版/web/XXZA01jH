    };
    // 评估执行一律在独立沉浸窗口中打开，避免医生端其他操作干扰
    const openRunWindow = (rec) => {
      const w = window.open("/doctor?run=" + rec, "hsrun_" + rec, "width=1320,height=920,menubar=no,toolbar=no");
      if (!w) { msg.warning("浏览器拦截了新窗口，已改为当前页执行"); runRec.value = rec; view.value = "assess-run"; nextTick(loadRun); return false; }
