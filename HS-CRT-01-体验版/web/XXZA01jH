              <el-table-column prop="domain" label="认知域" min-width="118" align="center" />
              <el-table-column prop="code" label="方案" min-width="86" align="center" />
              <el-table-column prop="name" label="名称" min-width="126" align="center" />
              <el-table-column label="训练形式" min-width="108" align="center"><template #default="s">{{ archName(s.row.archetype) }}</template></el-table-column>
              <el-table-column label="关卡" min-width="68" align="center"><template #default="s">{{ s.row.levelCount }} 关</template></el-table-column>
              <el-table-column label="状态" min-width="80" align="center"><template #default="s">
                <span v-if="basket.some(b => b.program === s.row.code)" class="st-none">已加入</span>
                <span v-else style="color:var(--c-text-3);font-size:12px">—</span>
              </template></el-table-column>
              <el-table-column label="操作" width="80" align="center"><template #default="s">
                <el-button size="small" text type="primary" :disabled="basket.some(b => b.program === s.row.code)" @click="addManual(s.row)">加入</el-button>
              </template></el-table-column>
            </el-table>
            <template #footer>
              <span style="float:left;font-size:12px;color:var(--c-text-3);line-height:32px">已勾选 {{ trainPick.sel.length }} 项</span>
