    const ap = reactive({ pid: null, patient: null, planId: null, custom: false, customDone: false, customName: "", identityOk: false, items: [] });
    const ckItems = ref([]);

    // 选择患者：mode=assess 发起评估（排除已有进行中评估的患者）；mode=train 配置训练方案（须已完成评估且不在训练中）
    const pick = reactive({ show: false, kw: "", page: 1, size: 8, mode: "assess" });
    const pickAll = computed(() => {
