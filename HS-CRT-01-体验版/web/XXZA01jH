              <el-button type="primary" :disabled="!trainPick.sel.length" @click="addManualBatch">加入所选</el-button>
            </template>
          </el-dialog>

        <!-- ---------- 作废评估 ---------- -->
        <el-dialog v-model="cx.show" :title="'作废评估 · ' + cx.name" width="460px">
