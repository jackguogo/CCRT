      // 训练认知域：当前方案内各认知域训练次数
      if (b === "train" && recTrainView.value === "domain") {
        const pl = recPlan.value; if (!pl || !pl.domains.length) return;
        const ds = [...pl.domains].reverse();
        chart(recDom.value, {
          tooltip: { trigger: "item", formatter: p => `${p.name}<br/>${p.value} 次 · 覆盖 ${ds[p.dataIndex].programs} 个方案 · 均分 ${ds[p.dataIndex].avgAcc}%` },
          grid: { left: 78, right: 52, top: 12, bottom: 12 },
          xAxis: { type: "value", splitLine: { lineStyle: { color: "#f1f4f7" } }, axisLabel: { color: "#8b9aa8", fontSize: 10.5 } },
          yAxis: { type: "category", data: ds.map(x => x.domain), axisLine: { show: false }, axisTick: { show: false }, axisLabel: { color: "#4b5f72", fontSize: 11.5 } },
          series: [{
            type: "bar", barWidth: 14,
            data: ds.map(x => ({ value: x.sessions, itemStyle: { color: DOMHEX[x.domain], borderRadius: [0, 4, 4, 0] } })),
            label: { show: true, position: "right", formatter: "{c} 次", color: "#7b8b9a", fontSize: 10.5 },
          }],
        });
      }

      // 依从性：方案周期内逐周执行量 vs 方案目标
      if (b === "adhere") {
        const pl = recAdhPlan.value; if (!pl || !pl.weekly.length) return;
        const w = pl.weekly;
        chart(recWeek.value, {
          tooltip: { trigger: "axis" },
          grid: { left: 40, right: 16, top: 26, bottom: 26 },
          xAxis: { type: "category", data: w.map(x => x.week.slice(5)), ...AXL },
          yAxis: { type: "value", minInterval: 1, splitLine: { lineStyle: { color: "#f1f4f7" } }, axisLabel: { color: "#8b9aa8", fontSize: 10.5 } },
          series: [{
            name: "训练次数", type: "bar", barWidth: 18,
            data: w.map(x => ({ value: x.sessions, itemStyle: { color: x.rate >= 80 ? "#0e9f8a" : x.rate >= 50 ? "#d97706" : "#e05252", borderRadius: [4, 4, 0, 0] } })),
            markLine: { silent: true, symbol: "none", data: [{ yAxis: pl.target, label: { formatter: "目标 " + pl.target + " 次", fontSize: 10, color: "#7b8b9a" }, lineStyle: { color: "#c3ced8", type: "dashed" } }] },
          }],
        });
      }
    };
    watch([recBlock, recTrainView, recAdhPlanId], () => nextTick(() => drawRec()));
    watch(recBlock, (b) => { if (b === "review") loadRecCmp(); });

    /* 当前选中的训练方案 / 依从性方案 */
    const recPlan = computed(() => {
      const d = rec.value; if (!d) return null;
      return d.plans.find(p => p.id === recPlanId.value) || d.plans[0] || null;
    });
    const recAdhPlan = computed(() => {
      const d = rec.value; if (!d) return null;
      return d.plans.find(p => p.id === recAdhPlanId.value) || d.plans[0] || null;
    });
    /* 评估记录：第几次（正序）+ 该次报告的雷达与六域分值（口径与报告页一致） */
    const recAssessIdx = computed(() => {
      const d = rec.value; if (!d || !recAssessId.value) return 0;
      const i = d.assess.findIndex(x => x.id === recAssessId.value);
      return i < 0 ? 0 : d.assess.length - i;
    });
    const recRepRadar = computed(() => (recRep.value ? radarSvg(recRep.value.radar, { showVal: false }) : null));
    const recRepDoms = computed(() => {
      const r = recRep.value ? recRep.value.radar : null;
      return DOMS.map(d => ({ d, v: r && r[d] != null ? r[d] : null }));
    });

    /* 依从性：按方案周期铺日历（周一起始，共 N 周） */
    const recCal = computed(() => {
      const pl = recAdhPlan.value;
      if (!pl || !pl.startAt) return { cells: [], weeks: 0 };
      const map = {};
      (pl.daily || []).forEach(x => { map[x.d] = x; });
      const start = new Date(pl.startAt + "T00:00:00");
      start.setDate(start.getDate() - ((start.getDay() + 6) % 7));
      const today = new Date(); today.setHours(0, 0, 0, 0);
      const weeks = pl.weeks || 1;
      const cells = [];
      for (let i = 0; i < weeks * 7; i++) {
        const dt = new Date(start.getTime() + i * 86400000);
        const k = dt.getFullYear() + "-" + p2(dt.getMonth() + 1) + "-" + p2(dt.getDate());
        const r0 = map[k];
        const m = r0 ? r0.minutes : 0;
        let lv = "l0";
        if (dt > today) lv = "fut";
        else if (m > 0 && m < 10) lv = "l1";
        else if (m >= 10 && m < 20) lv = "l2";
        else if (m >= 20 && m < 30) lv = "l3";
        else if (m >= 30) lv = "l4";
        cells.push({ d: k, minutes: m, sessions: r0 ? r0.sessions : 0, lv });
      }
      return { cells, weeks };
    });
    const recAdhStats = computed(() => {
      const pl = recAdhPlan.value;
      if (!pl) return null;
      const wk = pl.weekly || [];
      // 中断周只统计「已完整过去」的周：疗程还在跑时，后面的空周不算中断
      const t0 = new Date(); t0.setHours(0, 0, 0, 0);
      const elapsed = (w) => {
        const s = new Date(String(w.week) + "T00:00:00");
        return !isNaN(s.getTime()) && new Date(s.getTime() + 6 * 86400000) < t0;
      };
      return {
        weeks: wk.length,
        okWeeks: wk.filter(w => w.rate >= 80).length,
        missWeeks: wk.filter(w => w.sessions === 0 && elapsed(w)).length,
        rate: pl.expectSessions ? Math.round((pl.doneSessions / pl.expectSessions) * 100) : 0,
        done: pl.doneSessions, expect: pl.expectSessions, target: pl.target, freq: pl.freq,
      };
    });

    /* 训练效果：按时间节点串起「评估 / 训练干预」，认知域画像可选任意两次评估对比
     * reports 由服务端按时间升序下发（旧 → 新），序号即第 N 次评估。 */
    const recBaseId = ref(null), recCurId = ref(null);
    const recReports = computed(() => (rec.value ? rec.value.reports || [] : []));
    const recReportNo = (r) => recReports.value.findIndex(x => x.id === r.id) + 1;
    const recRepLabel = (r) => `第 ${recReportNo(r)} 次评估 · ${(r.created_at || "").slice(0, 10)}`;
    /* 默认对比：最新一次 vs 上一次；只有一次评估时对比为空 */
    const initRecCompare = () => {
      const rs = recReports.value;
      const cur = rs.length ? rs[rs.length - 1].id : null;
      const base = rs.length > 1 ? rs[rs.length - 2].id : null;
      if (!rs.some(x => x.id === recCurId.value)) recCurId.value = cur;
      if (!rs.some(x => x.id === recBaseId.value)) recBaseId.value = base;
      if (recCurId.value === recBaseId.value) recBaseId.value = base;
    };
    /* 时间轴：每次评估 + 每段训练，按日期排序 */
    const recTimeline = computed(() => {
      const d = rec.value; if (!d) return [];
      const nodes = [];
      recReports.value.forEach(r => {
        nodes.push({ kind: "assess", id: r.id, at: (r.created_at || "").slice(0, 10), no: recReportNo(r), report_no: r.report_no });
      });
      (d.plans || []).filter(p => p.doneSessions > 0).forEach((p, i) => {
        const from = (p.startAt || "").slice(0, 10), to = (p.endAt || "").slice(0, 10);
        const days = from && to ? Math.round((new Date(to) - new Date(from)) / 86400000) : 0;
        nodes.push({ kind: "train", id: p.id, at: from, to, days, sessions: p.doneSessions, plans: 1, idx: i + 1 });
      });
      return nodes.sort((x, y) => x.at === y.at ? (x.kind === "assess" ? -1 : 1) : (x.at < y.at ? -1 : 1));
    });
    /* 点时间轴上的评估：设为对比，基线自动取其上一次 */
    const pickTimelineAssess = (n) => {
      if (n.kind !== "assess") return;
      const rs = recReports.value;
      const i = rs.findIndex(r => r.id === n.id);
      if (i < 0) return;
      recCurId.value = n.id;
      recBaseId.value = i > 0 ? rs[i - 1].id : null;
    };
    const recReview = computed(() => {
      const d = rec.value; if (!d) return null;
      const rs = recReports.value;
      const a = rs.find(r => r.id === recBaseId.value), b = rs.find(r => r.id === recCurId.value);
      if (!a || !b) return null;
      const aAt = (a.created_at || "").slice(0, 10), bAt = (b.created_at || "").slice(0, 10);
      const plans = (d.plans || []).filter(p => p.doneSessions > 0 && (p.startAt || "") >= aAt && (p.startAt || "") <= bAt);
      const doms = DOMS.map(k => {
        const f = a.radar[k] != null ? a.radar[k] : null;
        const l = b.radar[k] != null ? b.radar[k] : null;
        return { d: k, f, l, delta: f != null && l != null ? l - f : null };
      });
      const valid = doms.filter(x => x.delta != null);
      return {
        first: a, last: b, doms, plans,
        baseNo: recReportNo(a), curNo: recReportNo(b),
        sessions: plans.reduce((s, p) => s + p.doneSessions, 0),
        avg: valid.length ? +(valid.reduce((s, x) => s + x.delta, 0) / valid.length).toFixed(1) : null,
        up: valid.filter(x => x.delta > 0).length,
        down: valid.filter(x => x.delta < 0).length,
        spanDays: Math.round((new Date(bAt) - new Date(aAt)) / 86400000),
      };
    });
    watch([recBaseId, recCurId], () => { if (recBlock.value === "review") loadRecCmp(); });
    /* 训练效果：量表得分前后对比（取所选两次报告的量表结果） */
    const recCmpScales = ref([]);
    const loadRecCmp = async () => {
      const rv = recReview.value;
      recCmpScales.value = [];
      if (!rv) return;
      try {
        const [fa, fb] = await Promise.all([getRep(rv.first.id), getRep(rv.last.id)]);
        const sa = (fa.chart || []).filter(c => c.kind === "scale");
        const sb = (fb.chart || []).filter(c => c.kind === "scale");
        recCmpScales.value = sa.map(x => {
          const y = sb.find(z => z.name === x.name);
          return {
            name: x.name, max: x.max,
            f: x.total != null ? x.total : null,
            l: y && y.total != null ? y.total : null,
            delta: y && x.total != null && y.total != null ? y.total - x.total : null,
          };
        });
      } catch (e) { /* 忽略：对比表为空即可 */ }
    };

    /* 患者选择：姓名 / 门诊号 / 科室 模糊搜索 */
    const recPickList = computed(() => {
      const k = recPick.kw.trim();
      return patients.value.filter(p => !k || (p.name || "").indexOf(k) >= 0 || (p.outpatient_no || "").indexOf(k) >= 0 || (p.dept || "").indexOf(k) >= 0);
    });
    const recPickTotal = computed(() => recPickList.value.length);
    const recPickRows = computed(() => recPickList.value.slice((recPick.page - 1) * recPick.size, recPick.page * recPick.size));
    const recPickNo = (i) => (recPick.page - 1) * recPick.size + i + 1;
    const openRecPick = async () => {
      recPick.show = true; recPick.kw = ""; recPick.page = 1;
      try { await loadPatients(); } catch (e) { /* 无权限时沿用已加载列表 */ }
    };
    const chooseRecPatient = (p) => { recPick.show = false; openRecords(p.id, p.name, recBlock.value); };
    const totalMin = computed(() => (rec.value ? rec.value.summary.minutes : 0));

    /* ---------- 导航 ---------- */
    const nav = [["home", "工作台", "Odometer"], ["patients", "患者信息", "User"], ["assess", "评估功能", "FirstAidKit"], ["train", "训练功能", "Aim"], ["records", "数据记录", "TrendCharts"], ["plan", "方案管理", "Files"]];
    const PAGE = { home: "工作台", patients: "患者信息", detail: "患者详情", assess: "评估功能", "assess-new": "发起评估", "assess-check": "身份核对", "assess-start": "开始评估", "assess-run": "评估执行", "assess-review": "评分提交", report: "评估报告", plan: "方案管理", prescribe: "训练方案", records: "数据记录", train: "训练功能" };
    const MENU_OF = { home: "工作台", patients: "患者信息", detail: "患者信息", assess: "评估功能", "assess-new": "评估功能", "assess-check": "评估功能", "assess-start": "评估功能", "assess-run": "评估功能", "assess-review": "评估功能", report: "评估功能", plan: "方案管理", prescribe: "训练功能", train: "训练功能", records: "数据记录" };
    // 左侧菜单高亮：视图 → 菜单项 index（菜单 index 为 nav 的 key，二者必须一致）
    const MENU_KEY = { home: "home", patients: "patients", detail: "patients", assess: "assess", "assess-new": "assess", "assess-check": "assess", "assess-start": "assess", "assess-run": "assess", report: "assess", plan: "plan", prescribe: "train", train: "train", records: "records" };
    const go = (k) => {
