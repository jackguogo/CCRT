    const curList = computed(() =>
      assessTab.value === "running" ? assessRunning.value
        : assessTab.value === "voided" ? assessVoided.value
          : assessDone.value);
    const curTotal = computed(() => curList.value.length);
    const curPage = computed(() => aPager[assessTab.value].page);
    const curSize = computed(() => aPager[assessTab.value].size);
    const curSizes = [5, 10, 20];
    const curRows = computed(() => curList.value.slice((curPage.value - 1) * curSize.value, curPage.value * curSize.value));
    const curNo = (i) => (curPage.value - 1) * curSize.value + i + 1;
    const onCurPage = (v) => { aPager[assessTab.value].page = v; };
    const onCurSize = (v) => { aPager[assessTab.value].size = v; aPager[assessTab.value].page = 1; };
    // 作废：中途放弃本次评估，释放「同患者只允许 1 条进行中」的名额
    const CANCEL_REASONS = computed(() => {
      const list = dict.stop_reason.map(d => d.label);
      return list.length ? list : ["患者中途离开", "患者身体不适，无法继续", "评估方案选择有误", "重复发起评估", "其他原因"];
    });
    const cx = reactive({ show: false, id: null, name: "", plan: "", reason: "", saving: false });
    const openCancel = (row) => {
