    };

    const runRec = ref(null), runData = ref(null);
    const pForm = reactive({});          // 范式施测记录（按项目代码分组）
    const guideOpen = reactive({});      // 施测指导展开状态
    const quiz = reactive({ on: false, code: null, meta: null, idx: 0, ans: {}, score: {}, t0: 0, tip: false });
    /* 朗读开关：关闭后不再自动朗读指导语，正在朗读的立即停止 */
    const sound = reactive({ on: true });
    /* 右侧主试面板折叠状态（题号 / 评估操作 / 评分要点 / 本题评分） */
    const qxPanel = reactive({ open: true });
    const toggleSound = () => {
      sound.on = !sound.on;
      if (!sound.on) stopSpeak(); else speakCurrent();
    };

    const planItems = computed(() => runData.value ? JSON.parse(runData.value.items || "[]") : []);
    const doneCodes = computed(() => new Set(runData.value ? runData.value.details.map(d => d.code) : []));
    const doneCount = computed(() => planItems.value.filter(i => doneCodes.value.has(i.code)).length);
    const totalCount = computed(() => planItems.value.length);
    const allDone = computed(() => totalCount.value > 0 && doneCount.value >= totalCount.value);
    const answeredMap = computed(() => {
      const m = {};
      ((runData.value && runData.value.answered) || []).forEach(r => m[r.code] = r.c);
      return m;
    });
    const scoredMap = computed(() => {
      const m = {};
      ((runData.value && runData.value.scored) || []).forEach(r => m[r.code] = r.c);
      return m;
    });
    /* 主试口述量表没有作答记录，进度按「已评分题数」计；
       分母只算计分题——演示题（学习阶段、练习组）没有分档，不计入评分进度 */
    const scorable = (c) => (c.meta && c.meta.items ? c.meta.items.filter(it => !it.demo).length : 0);
    const qDone = (c) => (c.meta && c.meta.examinerOnly) ? (scoredMap.value[c.code] || 0) : c.answeredCount;
    const qLabel = (c) => (c.meta && c.meta.examinerOnly) ? "评分进度" : "作答进度";
    const qPct = (c) => {
      const n = (c.meta && c.meta.examinerOnly) ? scorable(c) : (c.meta && c.meta.items ? c.meta.items.length : 0);
      return n ? Math.round(qDone(c) / n * 100) : 0;
    };
    const qTotal = (c) => (c.meta && c.meta.examinerOnly) ? scorable(c) : (c.meta && c.meta.items ? c.meta.items.length : 0);

    const scaleCards = computed(() => {
      if (!runData.value || !banks.value) return [];
      return planItems.value.filter(i => i.type === "scale").map(i => {
        const meta = banks.value.scales.find(s => s.code === i.code) || null;
        return {
          code: i.code, meta, guide: meta ? meta.guide : null,
          det: runData.value.details.find(d => d.code === i.code) || null,
          answeredCount: answeredMap.value[i.code] || 0,
        };
      });
    });
    const paraCards = computed(() => {
      if (!runData.value || !banks.value) return [];
      return planItems.value.filter(i => i.type === "paradigm").map(i => {
        const meta = banks.value.paradigms.find(p => p.code === i.code) || null;
        return {
          code: i.code, meta, guide: meta ? meta.guide : null,
          det: runData.value.details.find(d => d.code === i.code) || null,
          answeredCount: answeredMap.value[i.code] || 0,
        };
      });
    });
    const detTotal = (det) => { try { const p = JSON.parse(det.payload); return p.total + " / " + p.max; } catch (e) { return ""; } };
    const metricText = (det) => {
      try { const p = JSON.parse(det.payload); return Object.entries(p.metrics || {}).map(([k, v]) => k + " " + v).join(" · "); } catch (e) { return ""; }
    };
    const toggleGuide = (code) => { guideOpen[code] = !guideOpen[code]; };

    /* ---- 患者施测：逐题作答 ---- */
    const quizItems = computed(() => (quiz.meta && quiz.meta.items) ? quiz.meta.items : []);
    /* 当前评估项目名称：主试版式顶栏展示，便于主试确认正在做哪个项目 */
    const quizProjectName = computed(() => (quiz.meta && quiz.meta.name) || quiz.code || "");
    const curQuizItem = computed(() => quizItems.value[quiz.idx] || null);
    const quizProgress = computed(() => quizItems.value.length ? Math.round((quiz.idx + 1) / quizItems.value.length * 100) : 0);
    const quizModeOf = (it) => {
      if (!it || !it.parts) return "oral";
      if (it.figure === "paper") return "paper";
      if (it.parts.some(p => p.mode === "draw")) return "draw";
      if (it.parts.some(p => p.mode === "order")) return "order";
      if (it.parts.some(p => p.mode === "choice")) return "choice";
      if (it.parts.some(p => p.mode === "fill")) return "fill";
      return "oral";
    };
    const curQuizMode = computed(() => quizModeOf(curQuizItem.value));
    /* 当前题的施测指导（指导语 / 客观操作 / 注意事项），来自 guide-data */
    const curQuizGuide = computed(() => {
      const it = curQuizItem.value, g = quiz.meta && quiz.meta.guide;
      if (!it || !g || !g.items) return null;
      return g.items[it.id] || null;
    });
    /* 主试口述量表（MMSE 等）：屏幕只给指导语，逐题由主试评分，不设患者交互 */
    const isExaminer = computed(() => !!(quiz.meta && quiz.meta.examinerOnly));
    const guideOf = (it) => {
      const g = quiz.meta && quiz.meta.guide;
      return (it && g && g.items && g.items[it.id]) || null;
    };
    const bandsOf = (it) => {
      const g = guideOf(it);
      return (g && g.bands && g.bands.length) ? g.bands : [];
    };
    const maxOf = (it) => bandsOf(it).reduce((a, b) => Math.max(a, Number(b[0]) || 0), 0);
    /* 患者侧只呈现指导语：没有指导语时才退回题干 */
    const curQuizSay = computed(() => {
      const it = curQuizItem.value, g = curQuizGuide.value;
      return (g && g.p) || (it && it.t) || "";
    });
    /* 作答单元：指令序列类条目（如 ADAS 命令）逐条列给主试念读 */
    const curQuizUnits = computed(() => {
      const g = curQuizGuide.value;
      return (g && Array.isArray(g.units)) ? g.units : [];
    });
    const curQuizBands = computed(() => bandsOf(curQuizItem.value));
    const curQuizMax = computed(() => maxOf(curQuizItem.value));
    const curQuizScore = computed(() => {
      const it = curQuizItem.value;
      if (!it) return null;
      const v = quiz.score[it.id];
      return v === undefined || v === null ? null : Number(v);
    });
    const curQuizScoreText = computed(() =>
      (curQuizScore.value === null ? "未评分" : curQuizScore.value + " 分") + " / " + curQuizMax.value);
    const setQuizScore = (v) => {
      const it = curQuizItem.value;
      if (!it) return;
      quiz.score[it.id] = Number(v) || 0;
    };

    /* ---- 词表类条目（ADAS 单词回忆 / 单词再认）：多套词表切换 + 逐词打钩计分 ---- */
    const wordState = reactive({ set: 0, trial: 0, marks: {} });
    const curWordList = computed(() => {
      const g = curQuizGuide.value;
      if (!g || !g.lists || !g.lists.length) return null;
      return { sets: g.lists, mode: g.wordScore || "recall" };
    });
    const wordSet = computed(() => {
      if (!curWordList.value) return null;
      const i = Math.min(wordState.set, curWordList.value.sets.length - 1);
      return curWordList.value.sets[i];
    });
    const wordHit = (gi, w) => !!wordState.marks[gi + "|" + w];
    const wordCount = (gi) => {
      const s = wordSet.value;
      if (!s || !s.groups[gi]) return 0;
      return s.groups[gi].words.filter(w => wordHit(gi, w)).length;
    };
    /* 回忆类：分组 = 逐次试验，一次只呈现一组；再认类：分组 = 旧词/新词，同屏呈现 */
    const isTrialList = computed(() => !!(curWordList.value && curWordList.value.mode === "recall"
      && wordSet.value && wordSet.value.groups.length > 1));
    const wordTrialIdx = computed(() => isTrialList.value
      ? Math.min(wordState.trial, wordSet.value.groups.length - 1) : -1);
    const shownGroups = computed(() => {
      const s = wordSet.value;
      if (!s) return [];
      return isTrialList.value ? [wordTrialIdx.value] : s.groups.map((_, i) => i);
    });
    /* 某次试验未能回忆的词数 */
    const trialMiss = (gi) => {
      const s = wordSet.value;
      if (!s || !s.groups[gi]) return 0;
      return s.groups[gi].words.length - wordCount(gi);
    };
    const wordScore = computed(() => {
      const wl = curWordList.value, s = wordSet.value;
      if (!wl || !s) return 0;
      if (wl.mode === "recognize") {
        /* 再认：错误数 = 旧词漏认 + 新词误认（0–12，0 = 全对） */
        const oldTotal = s.groups[0].words.length;
        return Math.max(0, Math.min(12, (oldTotal - wordCount(0)) + wordCount(1)));
      }
      /* 回忆：评分 = 各次试验未能回忆词数的平均数（0 = 全部回忆出，10 = 全部未回忆） */
      const n = s.groups.length || 1;
      const sum = s.groups.reduce((a, g, gi) => a + (g.words.length - wordCount(gi)), 0);
      return Math.round(sum / n * 10) / 10;
    });
    const wordMarksN = computed(() => {
      if (!curWordList.value) return 0;
      return wordCount(0) + (curWordList.value.mode === "recognize" ? wordCount(1) : 0);
    });
    const wordScoreText = computed(() => {
      const wl = curWordList.value, s = wordSet.value;
      if (!wl || !s) return "";
      if (wl.mode === "recognize") {
        const miss = s.groups[0].words.length - wordCount(0);
        return `错误 ${wordScore.value} 个 · 旧词漏认 ${miss} · 新词误认 ${wordCount(1)}`;
      }
      const miss = s.groups.map((_, gi) => trialMiss(gi));
      if (miss.length > 1) return `各次未回忆 ${miss.join(" / ")} · 平均 ${wordScore.value} 个`;
      return `未能回忆 ${miss[0]} 个 · 已勾选 ${wordCount(0)} 个`;
    });
    const toggleWord = (gi, w) => {
      const k = gi + "|" + w;
      if (wordState.marks[k]) delete wordState.marks[k]; else wordState.marks[k] = 1;
      const it = curQuizItem.value;
      if (it) quiz.score[it.id] = wordScore.value;
    };
    const pickWordSet = (i) => {
      wordState.set = i; wordState.trial = 0; wordState.marks = {};
      const it = curQuizItem.value;
      if (it) quiz.score[it.id] = wordScore.value;
    };
    /* ---- 命名类条目（ADAS 命名）：勾选「命名正确」的项，按不正确项数自动对应分档 ---- */
    const namingState = reactive({ marks: {} });
    const curNaming = computed(() => {
      const g = curQuizGuide.value;
      if (!g || !g.naming || !g.naming.groups) return null;
      let k = 0;
      const groups = g.naming.groups.map(x => ({
        t: x.t,
        items: (x.items || []).map(it => ({ ...it, k: k++ })),
      }));
      return { groups, ranges: g.naming.ranges || [], all: groups.flatMap(x => x.items) };
    });
    /* 勾选数 = 命名正确项数 */
    const namingCount = computed(() => {
      const n = curNaming.value;
      if (!n) return 0;
      return n.all.filter(it => namingState.marks[it.k]).length;
    });
    /* 命名不正确项数 = 总项数 − 命名正确项数 */
    const namingWrong = computed(() => {
      const n = curNaming.value;
      return n ? n.all.length - namingCount.value : 0;
    });
    /* 不正确项数 → 对应分档分值（ranges 与 bands 同序） */
    const namingScore = computed(() => {
      const n = curNaming.value;
      if (!n) return null;
      const c = namingWrong.value;
      const i = n.ranges.findIndex(r => c >= r[0] && c <= r[1]);
      if (i < 0) return null;
      const b = curQuizBands.value[i];
      return b ? Number(b[0]) : null;
    });
    /* 物品线索按频率分组（仅右侧主试面板展示，不在左侧清单里露出答案） */
    const namingCues = computed(() => {
      const n = curNaming.value;
      if (!n) return [];
      const order = ["高", "中", "低"];
      const map = new Map();
      n.all.forEach(it => {
        if (!it.cue) return;
        const key = it.f || "其他";
        if (!map.has(key)) map.set(key, []);
        map.get(key).push(it);
      });
      return order.filter(k => map.has(k)).map(k => ({ t: k + "频率词", items: map.get(k) }));
    });
    const toggleNaming = (k) => {
      if (namingState.marks[k]) delete namingState.marks[k]; else namingState.marks[k] = 1;
      const it = curQuizItem.value;
      if (it && namingScore.value !== null) quiz.score[it.id] = namingScore.value;
    };
    /* 换题重置勾选；词表类条目按「一个词也没勾」起算（回忆 = 10 分全未回忆，再认 = 10 分全漏认），与纸笔记录单一致 */
    watch(() => quiz.idx + "|" + (quiz.code || ""), () => {
      wordState.set = 0; wordState.trial = 0; wordState.marks = {};
      namingState.marks = {};
      const it = curQuizItem.value;
      if (it && curWordList.value && quiz.score[it.id] === undefined) quiz.score[it.id] = wordScore.value;
      if (it && curNaming.value && quiz.score[it.id] === undefined) quiz.score[it.id] = namingScore.value;
    });

    /* 连线题：按顺序点选节点，点完自动连线 */
    const orderNodes = computed(() => (curQuizItem.value && curQuizItem.value.nodes) || []);
    const orderPicked = computed(() => {
      const it = curQuizItem.value;
      if (!it || !quiz.ans[it.id]) return [];
      const v = quiz.ans[it.id].parts[0];
      return v ? String(v).split(",").filter(Boolean) : [];
    });
    const orderSegs = computed(() => {
      const pos = {};
      orderNodes.value.forEach(n => pos[n[0]] = [n[1], n[2]]);
      const pk = orderPicked.value, out = [];
      for (let i = 0; i < pk.length - 1; i++) {
        const a = pos[pk[i]], b = pos[pk[i + 1]];
        if (a && b) out.push([a[0], a[1], b[0], b[1]]);
      }
      return out;
    });
    const pickNode = (label) => {
      const it = curQuizItem.value;
      if (!it || !quiz.ans[it.id]) return;
      const cur = orderPicked.value.slice();
      if (cur.includes(label)) return;
      cur.push(label);
      quiz.ans[it.id].parts[0] = cur.join(",");
    };
    const undoPick = () => {
      const it = curQuizItem.value;
      if (!it || !quiz.ans[it.id]) return;
      const cur = orderPicked.value.slice();
      cur.pop();
      quiz.ans[it.id].parts[0] = cur.join(",");
    };

    const stopSpeak = () => { try { if (window.speechSynthesis) window.speechSynthesis.cancel(); } catch (e) { } };
    const speak = (text) => {
      try {
        if (!sound.on || !window.speechSynthesis || !text) return;
        window.speechSynthesis.cancel();
        const u = new SpeechSynthesisUtterance(String(text));
        u.lang = "zh-CN"; u.rate = 0.85;
        window.speechSynthesis.speak(u);
      } catch (e) { }
    };
    const speakCurrent = () => {
      const it = curQuizItem.value;
      if (!it) return;
      speak(isExaminer.value ? curQuizSay.value : it.t);
    };

    /* ---- 口述题：按住说话按钮（呼吸提示 + 口述时长 + 语音转文本） ---- */
    const SR = window.SpeechRecognition || window.webkitSpeechRecognition || null;
    const mic = reactive({ on: false, t0: 0, id: null, live: "", err: "", supported: !!SR });
    let recog = null;
    const micStart = (e) => {
      if (e) e.preventDefault();
      stopSpeak();
      const it = curQuizItem.value;
      mic.on = true; mic.t0 = Date.now(); mic.id = it ? it.id : null; mic.live = ""; mic.err = "";
      if (!SR) return;
      const myId = mic.id;
      try {
        recog = new SR();
        recog.lang = "zh-CN"; recog.continuous = true; recog.interimResults = true;
        recog.onresult = (ev) => {
          let t = "";
          for (let i = 0; i < ev.results.length; i++) t += ev.results[i][0].transcript;
          mic.live = t;
        };
        recog.onerror = (ev) => {
          mic.err = ev.error === "not-allowed" ? "未授权麦克风，仅记录口述时长"
            : ev.error === "network" ? "语音服务不可用，仅记录口述时长" : "语音识别失败，仅记录口述时长";
        };
        recog.onend = () => {
          const t = (mic.live || "").trim();
          const a = myId ? quiz.ans[myId] : null;
          if (a && t) a.speech = ((a.speech || "") + t).slice(0, 800);
        };
        recog.start();
      } catch (err) { mic.err = "语音识别不可用，仅记录口述时长"; }
    };
    const micStop = () => {
      if (!mic.on) return;
      mic.on = false;
      const sec = Math.max(1, Math.round((Date.now() - mic.t0) / 1000));
      const a = mic.id ? quiz.ans[mic.id] : null;
      if (a) a.spoken = (a.spoken || 0) + sec;
      if (recog) { try { recog.stop(); } catch (e) { } recog = null; }
    };
    const micSec = (id) => { const a = quiz.ans[id]; return a && a.spoken ? a.spoken : 0; };
    const micSpeech = (id) => { const a = quiz.ans[id]; return a && a.speech ? a.speech : ""; };

    /* ---- 主试施测：刺激材料 ---- */
    /* MoCA 交替连线图：按记录单原图坐标散布 10 个圆点（5、1、戊、甲、乙、2、丁、4、3、丙），
       1→甲→2 之间以虚线箭头提示起笔方向；被试在记录单上用笔连线，屏幕只作出示。 */
    const MOCA_PATH = [
      { l: "戊", x: 125, y: 31 }, { l: "甲", x: 254, y: 30 },
      { l: "5", x: 42, y: 104 }, { l: "乙", x: 230, y: 124 }, { l: "2", x: 325, y: 124 },
      { l: "1", x: 125, y: 152 }, { l: "丁", x: 60, y: 233 }, { l: "4", x: 207, y: 229 },
      { l: "3", x: 322, y: 248 }, { l: "丙", x: 125, y: 285 },
    ];
    /* 起笔方向提示：1→甲、甲→2（已按圆半径留出箭尾与箭头间隙） */
    const MOCA_ARROWS = [[142, 136, 233, 49], [269, 49, 308, 102]];
    const MOCA_LABELS = [{ t: "开始", x: 125, y: 201 }, { t: "结束", x: 125, y: 79 }];

    /* ---- 三步命令：数字化折纸（拖动纸张 / 点击折边 / 放到左腿或地上） ---- */
    const paper = reactive({ x: 0, y: 0, foldsH: 0, foldsV: 0, zone: "", picked: false, drag: false, moved: false, sx: 0, sy: 0, ox: 0, oy: 0 });
    const PAPER_FOLDS = [
      { label: "上折", dir: "v", style: { left: "50%", top: "-15px", transform: "translateX(-50%)" } },
      { label: "下折", dir: "v", style: { left: "50%", bottom: "-15px", transform: "translateX(-50%)" } },
      { label: "左折", dir: "h", style: { left: "-15px", top: "50%", transform: "translateY(-50%)" } },
      { label: "右折", dir: "h", style: { right: "-15px", top: "50%", transform: "translateY(-50%)" } },
    ];
    const resetPaper = () => {
      paper.x = 0; paper.y = 0; paper.foldsH = 0; paper.foldsV = 0;
      paper.zone = ""; paper.picked = false; paper.drag = false; paper.moved = false;
    };
    const syncPaper = () => {
      const it = curQuizItem.value;
      if (!it || !quiz.ans[it.id]) return;
      const f = paper.foldsH + paper.foldsV;
      const acts = [
        paper.picked ? "拿起纸张" : "未拿起",
        f ? `对折 ${f} 次` : "未对折",
        paper.zone === "leg" ? "放在左腿" : paper.zone === "floor" ? "放在地上" : "未放置",
      ];
      quiz.ans[it.id].parts[0] = acts.join(" → ");
    };
    const doFold = (dir) => {
      if (paper.zone) return;
      paper.picked = true;
      if (dir === "h") paper.foldsH = 1; else paper.foldsV = 1;
      syncPaper();
    };
    const paperDown = (e) => {
      paper.drag = true; paper.moved = false; paper.picked = true;
      paper.sx = e.clientX; paper.sy = e.clientY; paper.ox = paper.x; paper.oy = paper.y;
      syncPaper();
      e.preventDefault();
    };
    const paperMove = (e) => {
      if (!paper.drag) return;
      const dx = e.clientX - paper.sx, dy = e.clientY - paper.sy;
      if (Math.abs(dx) > 6 || Math.abs(dy) > 6) paper.moved = true;
      paper.x = paper.ox + dx; paper.y = paper.oy + dy;
    };
    const paperUp = () => {
      if (!paper.drag) return;
      paper.drag = false;
      // 未拖动 = 单击纸张：取回并重置，便于重做
      if (!paper.moved) {
        if (paper.zone || paper.foldsH || paper.foldsV) {
          paper.zone = ""; paper.foldsH = 0; paper.foldsV = 0; paper.x = 0; paper.y = 0; syncPaper();
        }
        return;
      }
      const el = document.querySelector(".quiz-paper");
      if (!el) return;
      const pr = el.getBoundingClientRect();
      // 以纸张中心点落位为准，避免纸张体积较大时同时压住两个区域
      const cx = pr.left + pr.width / 2, cy = pr.top + pr.height / 2;
      for (const z of ["leg", "floor"]) {
        const ze = document.querySelector(".paper-zone." + z);
        if (!ze) continue;
        const zr = ze.getBoundingClientRect();
        if (cx >= zr.left && cx <= zr.right && cy >= zr.top && cy <= zr.bottom) {
          paper.zone = z; paper.x = 0; paper.y = 0; syncPaper(); return;
        }
      }
    };
    const dropTo = (z) => { paper.picked = true; paper.zone = z; paper.x = 0; paper.y = 0; syncPaper(); };
    const paperHint = computed(() => {
      if (paper.zone) return `纸张已放在${paper.zone === "leg" ? "左腿" : "地上"}，点纸张可取回重做`;
      if (paper.foldsH + paper.foldsV) return "已对折，请把它放到左腿或地上";
      return "拖动纸张可以移动，点击纸边的小按钮可以对折";
    });

    const saveCanvas = () => {
      if (curQuizMode.value !== "draw") return;
      const cv = document.querySelector("canvas.quiz-canvas");
      const it = curQuizItem.value;
      if (!cv || !it || !quiz.ans[it.id]) return;
      // 未落笔则视为未作答，避免存下一张空白图
      if (Number(cv.dataset.ink || 0) === 0) { quiz.ans[it.id].parts[0] = null; return; }
      quiz.ans[it.id].parts[0] = cv.toDataURL("image/png");
    };
    const initQuizCanvas = () => {
      nextTick(() => {
        const cv = document.querySelector("canvas.quiz-canvas");
        const it = curQuizItem.value;
        if (!cv || !it || curQuizMode.value !== "draw") return;
        cv.width = 640; cv.height = 320;
        const ctx = cv.getContext("2d");
        ctx.fillStyle = "#fff"; ctx.fillRect(0, 0, cv.width, cv.height);
        ctx.lineWidth = 3; ctx.lineCap = "round"; ctx.lineJoin = "round"; ctx.strokeStyle = "#0f172a";
        const saved = quiz.ans[it.id] && quiz.ans[it.id].parts[0];
        cv.dataset.ink = saved ? "1" : "0";
        if (saved) { const img = new Image(); img.onload = () => ctx.drawImage(img, 0, 0, cv.width, cv.height); img.src = saved; }
        let dr = false, last = null;
        const pos = e => { const r = cv.getBoundingClientRect(); const t = e.touches ? e.touches[0] : e; return [(t.clientX - r.left) * (cv.width / r.width), (t.clientY - r.top) * (cv.height / r.height)]; };
        cv.onpointerdown = e => {
          dr = true; last = pos(e);
          cv.dataset.ink = String(Number(cv.dataset.ink || 0) + 1);
          ctx.fillStyle = "#0f172a"; ctx.beginPath(); ctx.arc(last[0], last[1], 1.6, 0, 7); ctx.fill();
          e.preventDefault();
        };
        cv.onpointermove = e => {
          if (!dr) return; const p = pos(e);
          ctx.strokeStyle = "#0f172a"; ctx.beginPath(); ctx.moveTo(last[0], last[1]); ctx.lineTo(p[0], p[1]); ctx.stroke();
          last = p; e.preventDefault();
        };
        cv.onpointerup = cv.onpointerleave = () => { dr = false; };
      });
    };
    const afterNav = () => { mic.on = false; initQuizCanvas(); speakCurrent(); quiz.t0 = Date.now(); };
    /* 作答耗时：记录每题停留秒数（来回切换时累加），作为报告里的客观指标；结算后清零避免重复累加 */
    const stampQuiz = () => {
      const it = curQuizItem.value;
      if (!it || !quiz.t0) return;
      const a = quiz.ans[it.id];
      const sec = Math.max(1, Math.round((Date.now() - quiz.t0) / 1000));
      if (a) a.sec = (a.sec || 0) + sec;
      quiz.t0 = 0;
    };

    const startQuiz = async (meta) => {
      if (!meta || !meta.items) return;
      quiz.code = meta.code; quiz.meta = meta; quiz.idx = 0; quiz.ans = {}; quiz.score = {};
      mic.on = false;
      resetPaper();
      meta.items.forEach(it => {
        const mode = quizModeOf(it);
        quiz.ans[it.id] = { parts: it.parts.map(() => (mode === "draw" ? null : "")) };
      });
      // 主试口述量表：恢复已评分数，并从第一道尚未评分的题目继续
      if (meta.examinerOnly) {
        try {
          const rv = await api("/assessments/" + runRec.value + "/review");
          const pj = (rv.projects || []).find(x => x.code === meta.code);
          if (pj) {
            let first = -1;
            pj.items.forEach((r, i) => {
              if (r.scored) quiz.score[r.id] = Number(r.score) || 0;
              else if (first < 0) first = i;
            });
            quiz.idx = first >= 0 ? first : Math.max(0, meta.items.length - 1);
          }
        } catch (e) { /* 无历史评分时从第一题开始 */ }
        quiz.on = true;
        quiz.t0 = Date.now();
        nextTick(() => speakCurrent());
        return;
      }
      // 续测断点：定位到上次最后作答的那道题
      let last = -1;
      try {
        const saved = await api("/assessments/" + runRec.value + "/answers?code=" + meta.code);
        Object.keys(saved || {}).forEach(k => {
          const v = saved[k];
          if (quiz.ans[k] && v && Array.isArray(v.parts) && v.parts.length === quiz.ans[k].parts.length) {
            quiz.ans[k] = v;
            const i = meta.items.findIndex(x => x.id === k);
            if (i > last) last = i;
          }
        });
      } catch (e) { /* 无历史作答时忽略 */ }
      if (last >= 0) quiz.idx = last;
      quiz.on = true;
      quiz.t0 = Date.now();
      nextTick(() => { initQuizCanvas(); speakCurrent(); });
    };
    const nextQ = () => {
      if (isExaminer.value) {
        const it = curQuizItem.value;
        /* 演示题（学习阶段 / 练习组）没有分档，不拦评分 */
        if (it && !it.demo && quiz.score[it.id] === undefined) return msg.warning("请先为本题评分");
      }
      saveCanvas(); stampQuiz();
      if (quiz.idx >= quizItems.value.length - 1) return finishQuiz();
      quiz.idx++; afterNav();
    };
    const prevQ = () => { saveCanvas(); stampQuiz(); if (quiz.idx > 0) { quiz.idx--; afterNav(); } };

    const persistAnswers = async () => {
      // 主试口述量表不记录机器作答，评分另存
      if (isExaminer.value) return 0;
      // 只提交已翻到且确有作答内容的题目；口述类翻到即视为已作答，未填写的填空题不计入进度
      const answers = {};
      quizItems.value.slice(0, quiz.idx + 1).forEach(it => {
        const a = quiz.ans[it.id];
        if (!a) return;
        const hasContent = quizModeOf(it) === "oral"
          || a.parts.some(v => v !== "" && v !== null && v !== undefined);
        if (hasContent) answers[it.id] = a;
      });
      const n = Object.keys(answers).length;
      if (n) await api("/assessments/" + runRec.value + "/answers", { method: "POST", body: { code: quiz.code, answers } });
      return n;
    };
    /* ---- 主试口述量表：逐题评分 → 完成评估 → 核对全部题目与评分 → 确认 ---- */
    const qp = reactive({ show: false, code: null, name: null, rows: [], total: 0, max: 0, allDone: false });
    const persistQuizScores = async () => {
      const scores = {};
      quizItems.value.forEach(it => {
        const v = quiz.score[it.id];
        if (v !== undefined && v !== null) scores[it.id] = Number(v) || 0;
      });
      const n = Object.keys(scores).length;
      if (n) await api("/assessments/" + runRec.value + "/review-scores", { method: "POST", body: { code: quiz.code, scores } });
      return n;
    };
    const finishExaminerQuiz = async () => {
      saveCanvas(); stampQuiz();
      const miss = quizItems.value.findIndex(it => !it.demo && quiz.score[it.id] === undefined);
      if (miss >= 0) { quiz.idx = miss; return msg.warning("第 " + (miss + 1) + " 题尚未评分"); }
      const code = quiz.code, name = quiz.meta ? quiz.meta.name : code;
      try {
        await persistQuizScores();
        const rd = await api("/assessments/" + runRec.value + "/record-item", { method: "POST", body: { code } });
        quiz.on = false; stopSpeak();
        await loadRun();
        qp.code = code; qp.name = name; qp.allDone = !!(rd && rd.allDone);
        qp.rows = quizItems.value.map((it, i) => ({
          id: it.id, no: i + 1,
          t: (guideOf(it) && guideOf(it).p) || it.t,
          score: Number(quiz.score[it.id]) || 0,
          max: maxOf(it),
          demo: !!it.demo,
        }));
        qp.total = qp.rows.reduce((a, r) => a + r.score, 0);
        qp.max = qp.rows.reduce((a, r) => a + r.max, 0);
        qp.show = true;
      } catch (e) { quiz.on = false; stopSpeak(); msg.error(e.message); }
    };
    const backToQuiz = () => {
      qp.show = false;
      quiz.on = true;
      quiz.t0 = Date.now();
      nextTick(() => speakCurrent());
    };
    const confirmQuizDone = async () => {
      qp.show = false;
      if (!qp.allDone) { msg.success(qp.name + " 已完成，可继续下一项评估"); return; }
      try {
        const d = await api("/assessments/" + runRec.value + "/complete-review", { method: "POST" });
        msg.success("评估已完成，报告已生成：" + d.reportNo);
        await loadAssessList();
        openReport(d.reportId);
      } catch (e) { msg.error(e.message); }
    };
    const finishQuiz = async () => {
      if (isExaminer.value) return finishExaminerQuiz();
      saveCanvas(); stampQuiz();
      const code = quiz.code, name = quiz.meta ? quiz.meta.name : code;
      let n = 0;
      try { n = await persistAnswers(); } catch (e) { msg.error(e.message); }
      try {
        // 只记录作答，不计分：标记该项目完成（允许整项未作答，如实记录为 0 题）
        const rd = await api("/assessments/" + runRec.value + "/record-item", { method: "POST", body: { code } });
        quiz.on = false; stopSpeak();
        await loadRun();
        if (rd && rd.allDone) {
          msg.success("全部评估项目已完成，可评分并提交");
          return;
        }
        msg.success(n ? "本次评估已完成，作答记录已保存" : "本次评估已结束，该项未记录作答内容");
        // 按顺序衔接下一个未完成项目
        const next = scaleCards.value.find(c => !c.det && c.meta && c.meta.items)
          || paraCards.value.find(c => !c.det && c.meta && c.meta.items);
        if (next) {
          try {
            await mbx.confirm(`已完成「${name}」，是否继续评估「${next.meta.name}」？`, "继续评估",
              { type: "info", confirmButtonText: "继续评估", cancelButtonText: "稍后" });
            startQuiz(next.meta);
          } catch (e) { /* 医生选择稍后 */ }
        }
      } catch (e) { quiz.on = false; stopSpeak(); msg.error(e.message); }
    };
    const quitQuiz = async () => {
      try {
        await mbx.confirm("确认退出本次评估？已作答内容会保留缓存已答题目", "提示",
          { type: "warning", confirmButtonText: "确认退出", cancelButtonText: "继续作答" });
      } catch (e) { return; }
      saveCanvas();
      quiz.on = false; stopSpeak();
      try {
        if (isExaminer.value) await persistQuizScores();
        else await persistAnswers();
        await loadRun();
      } catch (e) { msg.error(e.message); }
    };

    /* ---- 评估情况：逐题展示评估结果（与评分页项目详情同构，只读） ---- */
    const recPanel = reactive({ show: false, code: null, project: null, loading: false });
    const openRecord = async (code) => {
      recPanel.code = code; recPanel.project = null; recPanel.show = true; recPanel.loading = true;
      try {
        const d = await api("/assessments/" + runRec.value + "/review");
        recPanel.project = (d.projects || []).find(p => p.code === code) || null;
      } catch (e) { msg.error(e.message); }
      recPanel.loading = false;
    };

    /* ---- 范式施测（医生按指导语施测后录入指标） ---- */
    const submitParadigm = async (c) => {
      const g = c.guide;
      if (!g || !g.fields || !g.fields.length) return msg.warning("该项目暂无评估记录项");
      const f = pForm[c.code] || {};
      const miss = g.fields.filter(x => f[x.k] === null || f[x.k] === undefined || f[x.k] === "");
      if (miss.length) return msg.warning(`请先记录：${miss.map(x => x.l).join("、")}`);
      const raw = {};
      g.fields.forEach(x => raw[x.k] = Number(f[x.k]) || 0);
      if (c.meta && c.meta.runner === "canvas") { raw.max = 10; raw.reviewed = true; }
      try {
        await api("/assessments/" + runRec.value + "/paradigm", { method: "POST", body: { code: c.code, raw } });
        msg.success((c.meta ? c.meta.name : c.code) + " 评估结果已记录");
        loadRun();
      } catch (e) { msg.error(e.message); }
    };

    const initRunUi = () => {
      if (!banks.value) return;
      planItems.value.forEach(i => {
        const done = doneCodes.value.has(i.code);
