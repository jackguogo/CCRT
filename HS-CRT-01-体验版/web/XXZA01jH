    const customItems = computed(() => ckItems.value.map(c => { const [t, code] = c.split(":"); return { type: t, code }; }));
    const customMinutes = computed(() => Math.max(10, ckItems.value.length * 10));
    // 临时自定义方案的名称：医生可自行命名（如「记忆与执行专项」），留空则按所选项目自动生成
    const autoName = computed(() => {
