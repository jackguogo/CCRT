<!DOCTYPE html>
<html lang="zh-CN"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width,initial-scale=1">
<title>医生端 · 认知功能障碍评估与训练软件 HS-CRT-01</title>
<link rel="stylesheet" href="/vendor/element-plus.css"><link rel="icon" href="/favicon.svg" type="image/svg+xml">
<link rel="stylesheet" href="/theme.css">
<style>[v-cloak]{display:none}
.rep-wrap{background:var(--c-bg)}
@media print{ .no-print{display:none!important} .lb-main{padding:0;background:#fff} body{background:#fff} }
</style></head><body>
<div id="app" v-cloak></div>
<script src="/vendor/vue.global.prod.js"></script>
<script src="/vendor/element-plus.full.min.js"></script>
<script src="/vendor/element-icons.iife.min.js"></script>
<script src="/vendor/element-zh-cn.min.js"></script>
<script src="/icons.js"></script>
<script src="/vendor/echarts.min.js"></script>
<script src="/vendor/qrcode.js"></script>
<script>
/* ============================================================================
   医生端 —— 菜单：工作台 / 患者信息 / 评估功能 / 方案管理 / 训练功能 / 数据记录
   业务闭环：患者登记 → 发起评估（身份核对）→ 量表施测 + 范式下发 → 报告
             → 据此配置训练方案 → 患者端训练 → 数据记录与阶段复评
   ========================================================================== */
const { createApp, ref, reactive, computed, onMounted, nextTick, watch } = Vue;
const El = ElementPlus;
const msg = El.ElMessage, mbx = El.ElMessageBox;

// 评估方案已改为服务端方案库（/api/v1/plan-lib），由「方案管理」统一维护
const DOMS = ["复合性注意", "执行能力", "学习与记忆", "语言", "视结构-知觉能力", "社会认知"];
const DOMBG = { "复合性注意": "var(--dom-ca-bg)", "执行能力": "var(--dom-ex-bg)", "学习与记忆": "var(--dom-lm-bg)", "语言": "var(--dom-la-bg)", "视结构-知觉能力": "var(--dom-vp-bg)", "社会认知": "var(--dom-sc-bg)" };
const DOMIC = null; // 六域图标由 icons.js 提供（hsIcon(域名称)）
const DOMFG = { "复合性注意": "var(--dom-ca)", "执行能力": "var(--dom-ex)", "学习与记忆": "var(--dom-lm)", "语言": "var(--dom-la)", "视结构-知觉能力": "var(--dom-vp)", "社会认知": "var(--dom-sc)" };
const DOMKEY = { "复合性注意": "ca", "执行能力": "ex", "学习与记忆": "lm", "语言": "la", "视结构-知觉能力": "vp", "社会认知": "sc" };

const App = {
  setup() {
    const runParam = new URLSearchParams(location.search).get("run");
    const immersive = ref(!!runParam);
    const tk = ref(localStorage.getItem("hs_tk") || "");
    const user = ref(null), banks = ref(null);
    const view = ref("home");
    const ICONS = window.HS_ICONS;               // 见 web/icons.js（统一 24×24 线性图标）
    const hsIcon = window.hsIcon;
    const domFilter = ref("");

    /* ---------- 训练方案库 · 效果测试 ----------
       打开 /train/<code>.html?preview=1：页面内嵌本地模拟结算，不调用任何后端接口，
       因此不会写入 train_record、不影响统计。这里再显式禁用 iframe 内的网络请求，
       并在样式层把试玩页的装饰性 emoji 换成数字疗法中性元素。 */
    // 项目配置由管理端维护：停用的量表/范式/训练方案不出现在新建与配置入口，历史记录照常展示
    const activeScales = computed(() => ((banks.value && banks.value.scales) || []).filter(x => x.enabled !== false));
    const activeParadigms = computed(() => ((banks.value && banks.value.paradigms) || []).filter(x => x.enabled !== false));
    const activeTrainings = computed(() => ((banks.value && banks.value.trainings) || []).filter(x => x.enabled !== false));
    const shownTrainings = computed(() => activeTrainings.value
      .filter(t => !domFilter.value || t.domain === domFilter.value));
    const domCount = (d) => activeTrainings.value.filter(t => t.domain === d).length;
    const preview = reactive({ show: false, code: "", name: "", domain: "", archetype: "", desc: "", levels: [] });
    const openPreview = (t) => {
      Object.assign(preview, {
        show: true, code: t.code, name: t.name, domain: t.domain,
        archetype: t.archetype || "", desc: t.desc || "", levels: t.levels || []
      });
    };
    const closePreview = () => { preview.show = false; };
    const onPreviewFrame = () => {
      nextTick(() => {
        const f = document.getElementById("tpFrame");
        if (!f) return;
        let d, w;
        try { d = f.contentDocument; w = f.contentWindow; } catch (e) { return; }
        if (!d || !w || d.getElementById("hsPreviewCss")) return;
        // 效果测试模式：网络请求一律拒绝，训练结算只走页面本地模拟
        w.fetch = () => Promise.reject(new Error("效果测试模式不产生网络请求"));
        const fg = DOMHEX[preview.domain] || "#0e9f8a";
        const st = d.createElement("style");
        st.id = "hsPreviewCss";
        st.textContent = `
          :root{--tp-fg:${fg}}
          body{background:#f7faf9!important}
          .hd{background:#fff!important;border-color:#e6ebf0!important;box-shadow:none!important}
          .hd .cover{background:var(--tp-fg)!important;color:#fff!important;box-shadow:none!important;font-size:0!important}
          .hd .cover .hs-ico{width:27px;height:27px}
          .hd h1{color:#1e2a35}
          .chip.active{background:var(--tp-fg)!important;border-color:transparent!important;box-shadow:none!important}
          .pbtn.primary{background:var(--tp-fg)!important;box-shadow:0 4px 0 rgba(16,40,64,.14)!important}
          .pbtn:hover{border-color:var(--tp-fg)!important}
          .goal{background:#f1f6f4!important;border-left-color:var(--tp-fg)!important;color:#5a6b7b!important}
          .hud{background:#1b3a34!important;box-shadow:none!important}
          .trail span{background:#eef4f2!important;color:var(--tp-fg)!important}
          .pcard{border-color:#e6ebf0!important;box-shadow:none!important}
          .ft,#ptitle,.settle-stars{display:none!important}
          .snd{font-size:0!important}
          .snd::after{content:"语音";font-size:12px;font-weight:600;color:#5a6b7b}
        `;
        d.head.appendChild(st);
        const cover = d.querySelector(".hd .cover");
        if (cover) cover.innerHTML = hsIcon(preview.code);
      });
    };

    const api = async (u, opt = {}) => {
      const r = await fetch("/api/v1" + u, { ...opt, headers: { "Content-Type": "application/json", Authorization: "Bearer " + tk.value }, body: opt.body ? JSON.stringify(opt.body) : undefined });
      if (r.status === 401) { tk.value = ""; localStorage.removeItem("hs_tk"); user.value = null; throw new Error("会话已过期，请重新登录"); }
      const j = await r.json(); if (j.code !== 0) throw new Error(j.message); return j.data;
    };

    /* ---------- 登录 ---------- */
    const lu = ref(""), lp = ref(""), logining = ref(false);
    /* 记住密码：仅存本机浏览器（localStorage），密码经 base64 转码后保存，取消勾选即清除 */
    const REMEMBER_KEY = "hs_remember_doctor";
    const remember = ref(false);
    const b64e = (s) => btoa(String.fromCharCode(...new TextEncoder().encode(s)));
    const b64d = (s) => { try { return new TextDecoder().decode(Uint8Array.from(atob(s), c => c.charCodeAt(0))); } catch (e) { return ""; } };
    const loadRemember = () => {
      try {
        const raw = localStorage.getItem(REMEMBER_KEY);
        if (!raw) return;
        const o = JSON.parse(raw);
        if (o && o.u) { lu.value = o.u; lp.value = b64d(o.p || ""); remember.value = true; }
      } catch (e) { }
    };
    const saveRemember = () => {
      try {
        if (remember.value && lu.value.trim()) localStorage.setItem(REMEMBER_KEY, JSON.stringify({ u: lu.value.trim(), p: b64e(lp.value) }));
        else localStorage.removeItem(REMEMBER_KEY);
      } catch (e) { }
    };
    watch(remember, (v) => { if (!v) { try { localStorage.removeItem(REMEMBER_KEY); } catch (e) { } } });
    const doLogin = async () => {
      if (!lu.value.trim() || !lp.value) return msg.warning("请输入账号与密码");
      logining.value = true;
      try {
        const d = await api("/auth/login", { method: "POST", body: { username: lu.value.trim(), password: lp.value } });
        if (d.user.role === "patient") return msg.error("请使用患者端登录患者账号");
        saveRemember();
        tk.value = d.token; localStorage.setItem("hs_tk", d.token); user.value = d.user;
        banks.value = await api("/banks"); await loadDict();
        await loadPatients(); loadAssessList(); loadPlanLib(); loadWkSummary();
        if (runParam) enterRun();
        msg.success("欢迎，" + d.user.name);
      } catch (e) { msg.error(e.message); } finally { logining.value = false; }
    };
    const logout = async () => {
      try { await mbx.confirm("确认退出登录？", "提示", { type: "warning" }); } catch (e) { return; }
      tk.value = ""; localStorage.removeItem("hs_tk"); user.value = null;
    };

    /* ---------- 患者查询 ---------- */
    const kw = ref(""), patients = ref([]);
    const loadPatients = async () => { patients.value = await api("/patients?kw=" + encodeURIComponent(kw.value)); };
    const ageOf = (b) => Math.floor((Date.now() - new Date(b)) / 31557600000);
    /* 业务字典：科室 / 学历 / 职称 / 患者来源 / 评估类型 / 终止原因，由管理端维护 */
    const dict = reactive({ dept: [], education: [], title: [], source: [], assess_type: [], stop_reason: [] });
    const loadDict = async () => {
      for (const t of Object.keys(dict)) {
        try { dict[t] = await api("/dict/" + t); } catch (e) { dict[t] = []; }
      }
    };
    /* 科室筛选 + 前端分页（查询区域 → 表单/列表区域） */
    const deptFilter = ref("");
    // 字典项优先；存量患者中出现过但尚未录入字典的科室一并列出，避免筛选漏项
    const deptOptions = computed(() => [...new Set([
      ...dict.dept.map(d => d.label),
      ...patients.value.map(p => p.dept).filter(Boolean),
    ])]);
    /* 评估状态筛选：未开始 = 尚无评估记录（接口回 "-"） */
    const assessFilter = ref("");
    const ASSESS_STATES = ["未开始", "进行中", "已完成", "已作废"];
    const assessStateOf = (p) => (p.assess_status && p.assess_status !== "-") ? p.assess_status : "未开始";
    const patientsShown = computed(() => patients.value.filter(p => {
      if (deptFilter.value && p.dept !== deptFilter.value) return false;
      if (assessFilter.value && assessStateOf(p) !== assessFilter.value) return false;
      return true;
    }));
    const pPage = ref(1), pSize = ref(10);
    const pagedPatients = computed(() => patientsShown.value.slice((pPage.value - 1) * pSize.value, pPage.value * pSize.value));
    const rowNo = (i) => (pPage.value - 1) * pSize.value + i + 1;
    // 状态色块：进行中（橙）/ 已完成（绿）/ 已终止（灰）/ 未开展（-）
    const stClass = (v) => v === "进行中" ? "run" : v === "已完成" ? "done" : (v === "已终止" || v === "已作废") ? "none" : "wait";
    const onPSize = (v) => { pSize.value = v; pPage.value = 1; };

    /* 训练情况表：完成评估才可进入训练；列表只含已开始训练的患者（训练中 / 已完成） */
    const trainTab = ref("all");
    const trainPage = ref(1), trainSize = ref(10);
    const trainStateOf = (p) => (p.train_status && p.train_status !== "-") ? p.train_status : "未开始";
    const assessed = (p) => (p.assess_done || 0) > 0;
    const trainEligible = computed(() => patients.value.filter(p => assessed(p) && trainStateOf(p) !== "未开始"));
    const trainRunning = computed(() => trainEligible.value.filter(p => trainStateOf(p) === "进行中"));
    const trainDone = computed(() => trainEligible.value.filter(p => trainStateOf(p) === "已完成"));
    /* 疗程到期由服务端自动归档为「已完成」，列表不再单独标记到期 */
    const trainShown = computed(() => trainTab.value === "running" ? trainRunning.value
      : trainTab.value === "done" ? trainDone.value : trainEligible.value);
    const trainTotal = computed(() => trainShown.value.length);
    const trainRows = computed(() => trainShown.value.slice((trainPage.value - 1) * trainSize.value, trainPage.value * trainSize.value));
    const trainNo = (i) => (trainPage.value - 1) * trainSize.value + i + 1;
    watch(trainTab, () => { trainPage.value = 1; });
    const doSearch = () => { pPage.value = 1; loadPatients(); };
    const resetSearch = () => { kw.value = ""; deptFilter.value = ""; assessFilter.value = ""; pPage.value = 1; loadPatients(); };
    watch(deptFilter, () => { pPage.value = 1; });
    watch(assessFilter, () => { pPage.value = 1; });
    const reg = reactive({ show: false, saving: false, form: {} });
    const blank = { name: "", sex: "男", birth_date: "", education: "初中", id_card: "", outpatient_no: "", dept: "康复科", phone: "", guardian: "", history: "" };
    const openReg = () => { Object.assign(reg.form, blank); reg.show = true; };
    const saveReg = async () => {
      if (!reg.form.name.trim()) return msg.warning("姓名为必填项");
      if (!reg.form.birth_date) return msg.warning("请选择出生日期");
      const f = reg.form;
      const opNo = (f.outpatient_no || "").trim() || "系统自动生成";
      const info = "请与患者当面核对以下信息：\n"
        + "姓名：" + f.name + " · " + f.sex + "\n"
        + "出生日期：" + f.birth_date + "（" + ageOf(f.birth_date) + " 岁）\n"
        + "教育程度：" + f.education + "\n"
        + "门诊号：" + opNo + "\n"
        + "科室：" + f.dept + "\n\n确认无误并保存建档？";
      try {
        await mbx.confirm(info, "建档前核对", { type: "warning", confirmButtonText: "核对无误，保存", customClass: "mbx-lg" });
      } catch (e) { return; }
      reg.saving = true;
      try {
        await api("/patients", { method: "POST", body: reg.form });
        reg.show = false; msg.success("登记成功");
        // 登记后停留在患者信息列表（新患者排首位），不自动打开详情
        kw.value = ""; deptFilter.value = ""; assessFilter.value = ""; pPage.value = 1;
        await loadPatients(); view.value = "patients";
      } catch (e) { msg.error(e.message); } finally { reg.saving = false; }
    };

    /* ---------- 患者详情 ---------- */
    const cur = ref(null);
    const openDetail = async (id) => {
      cur.value = await api("/patients/" + id);
      view.value = "detail";
    };

    /* ---------- 患者端登录码（家庭训练扫码进入） ---------- */
    const tkDlg = reactive({ show: false, loading: false, url: "", account: "", expires: "", err: "" });
    const openTicket = async (p) => {
      Object.assign(tkDlg, { show: true, loading: true, url: "", account: "", expires: "", err: "" });
      try {
        const d = await api("/patients/" + p.id + "/ticket", { method: "POST" });
        Object.assign(tkDlg, { url: d.url, account: d.account, expires: d.expires_at, loading: false });
        // 弹窗首次打开时内容才挂载，等两帧再绘制二维码
        await nextTick(); await nextTick();
        const box = document.getElementById("tkQr");
        if (box && window.qrcode) {
          const qr = window.qrcode(0, "M");
          qr.addData(d.url); qr.make();
          box.innerHTML = qr.createSvgTag({ cellSize: 5, margin: 2 });
        }
      } catch (e) { tkDlg.err = e.message; } finally { tkDlg.loading = false; }
    };

    /* ---------- 家属代操作账号 ---------- */
    const famDlg = reactive({ show: false, pid: 0, pname: "", rows: [], saving: false });
    const famForm = reactive({ real_name: "", relation: "", phone: "" });
    const loadFamily = async () => {
      try { famDlg.rows = await api("/patients/" + famDlg.pid + "/family"); } catch (e) { famDlg.rows = []; }
    };
    const openFamily = async (p) => {
      Object.assign(famDlg, { show: true, pid: p.id, pname: p.name });
      Object.assign(famForm, { real_name: "", relation: "", phone: "" });
      await loadFamily();
    };
    const addFamily = async () => {
      if (!famForm.real_name.trim()) return msg.warning("请填写家属姓名");
      famDlg.saving = true;
      try {
        const d = await api("/patients/" + famDlg.pid + "/family", { method: "POST", body: { ...famForm } });
        msg.success("已创建；账号 " + d.username + "，初始密码 123456");
        Object.assign(famForm, { real_name: "", relation: "", phone: "" });
        await loadFamily();
      } catch (e) { msg.error(e.message); } finally { famDlg.saving = false; }
    };
    const toggleFamily = async (f) => {
      try { await api("/family/" + f.id, { method: "PUT", body: { status: f.status ? 0 : 1 } }); msg.success("已更新"); loadFamily(); }
      catch (e) { msg.error(e.message); }
    };
    const resetFamilyPwd = async (f) => {
      try { await api("/family/" + f.id + "/reset-password", { method: "POST" }); msg.success("已重置为初始密码 123456"); }
      catch (e) { msg.error(e.message); }
    };
    const removeFamily = async (f) => {
      try { await mbx.confirm("解除「" + f.real_name + "」的代操作绑定？", "提示", { type: "warning" }); } catch (e) { return; }
      try { await api("/family/" + f.id, { method: "DELETE" }); msg.success("已解除"); loadFamily(); }
      catch (e) { msg.error(e.message); }
    };
    /* 详情页两张配置卡：已完成评估次数 / 当前进行中的训练方案 */
    const curAssessDone = computed(() => ((cur.value && cur.value.assess) || []).filter(a => a.status === "已完成").length);
    const activePlan = computed(() => ((cur.value && cur.value.plans) || []).find(p => p.status === "进行中") || null);
    /* 方案编号：按该患者方案的创建顺序从 1 编号（最早为 1），与「历次评估」口径一致 */
    const planNo = (pl) => {
      if (!pl) return "";
      const list = [...((cur.value && cur.value.plans) || [])].sort((a, b) => a.id - b.id);
      const i = list.findIndex(x => x.id === pl.id);
      return i >= 0 ? i + 1 : "";
    };
    const goPrescribe = () => {
      if (!curAssessDone.value) return msg.warning("该患者尚未完成评估，完成评估后才能配置训练方案");
      openPrescribe(cur.value.id);
    };
    /* 终止方案：after 指定终止后的刷新动作，缺省回患者详情 */
    const stopPlan = async (pl, after) => {
      const no = pl.no || planNo(pl);
      const who = pl.patientName ? `${pl.patientName}的训练方案` : "训练方案";
      try { await mbx.confirm(`确认终止${who}${no ? " " + no : ""}？终止后患者端不再显示该方案任务。`, "提示", { type: "warning" }); } catch (e) { return; }
      try {
        await api("/prescriptions/" + pl.id + "/status", { method: "PUT", body: { status: "已终止" } });
        msg.success("已终止");
        if (typeof after === "function") await after(); else openDetail(pl.patient_id);
      } catch (e) { msg.error(e.message); }
    };
    /* 训练情况表行内终止：按患者取当前进行中方案再终止 */
    const stopPlanOfPatient = async (row) => {
      let pl;
      try {
        const ps = await api("/prescriptions?patientId=" + row.id);
        pl = (ps || []).find(x => x.status === "进行中");
      } catch (e) { return msg.error(e.message); }
      if (!pl) return msg.warning("该患者当前没有进行中的训练方案");
      await stopPlan({ ...pl, patientName: row.name }, async () => { await loadPatients(); });
    };
    /* 训练方案页：终止该患者当前进行中的方案，终止后重载本页以便重新配置 */
    const stopActivePlan = async () => {
      const pl = activePlan.value; if (!pl || !cur.value) return;
      await stopPlan({ ...pl, patientName: cur.value.name }, async () => {
        await loadPatients();
        await openPrescribe(cur.value.id);
      });
    };
    /* ---------- 评估 ---------- */
    /* 方案库（方案管理 = 评估/训练方案唯一出口，评估功能直接调用） */
    const planLib = ref([]);
    const loadPlanLib = async () => { try { planLib.value = await api("/plan-lib?kind=assess"); } catch (e) { /* 忽略 */ } };
    const libStandard = computed(() => planLib.value.filter(p => p.category === "standard"));
    const libCustom = computed(() => planLib.value.filter(p => p.category === "custom"));
    const libTab = ref("standard");
    const planById = (id) => planLib.value.find(p => p.id === id);
    const itemName = (it) => {
      if (!banks.value) return it.code;
      const s = it.type === "scale" ? banks.value.scales.find(x => x.code === it.code) : banks.value.paradigms.find(x => x.code === it.code);
      return s ? s.name.replace(/（.*?）/g, "") : it.code;
    };
    const libEdit = reactive({ show: false, saving: false, id: null, isBuiltin: 0, category: "custom", name: "", desc: "", minutes: 30 });
    const libChecked = ref([]);
    const openLibEdit = (row) => {
      libEdit.id = row ? row.id : null;
      libEdit.isBuiltin = row ? row.is_builtin : 0;
      libEdit.category = row ? row.category : "custom";
      libEdit.name = row ? row.name : "";
      libEdit.desc = row ? row.desc : "";
      libEdit.minutes = row ? row.minutes : 30;
      libChecked.value = row ? row.items.map(i => i.type + ":" + i.code) : [];
      libEdit.show = true;
    };
    const saveLib = async () => {
      if (!libEdit.name.trim()) return msg.warning("请填写方案名称");
      if (!libChecked.value.length) return msg.warning("请至少选择一个评估项目");
      const items = libChecked.value.map(v => { const [type, code] = v.split(":"); return { type, code }; });
      libEdit.saving = true;
      try {
