                <g v-for="n in MOCA_PATH" :key="n.l">
                  <circle :cx="n.x" :cy="n.y" r="20" fill="#fff" stroke="#0f172a" stroke-width="2.2" />
                  <text :x="n.x" :y="n.y + 7" text-anchor="middle" font-size="19" font-weight="600" fill="#0f172a">{{ n.l }}</text>
                </g>
                <text v-for="lb in MOCA_LABELS" :key="lb.t" :x="lb.x" :y="lb.y" text-anchor="middle" font-size="12.5" fill="#64748b">{{ lb.t }}</text>
              </svg>
            </div>
            <div v-else-if="curQuizItem.figure === 'cube'" class="qx-fig">
              <svg viewBox="0 0 220 200" width="260" height="236">
                <g fill="none" stroke="#0f172a" stroke-width="2.4" stroke-linejoin="round">
                  <polygon points="30,60 150,60 150,180 30,180" />
                  <polygon points="70,22 190,22 190,142 150,180 150,60 70,60" />
                  <line x1="30" y1="60" x2="70" y2="22" />
                  <line x1="150" y1="60" x2="190" y2="22" />
                </g>
              </svg>
            </div>
            <div v-if="curQuizItem.card" class="qx-card">{{ curQuizItem.card }}</div>
            <div v-if="curQuizItem.animals" class="qx-animals">
              <img v-for="a in curQuizItem.animals" :key="a" class="qx-animal"
                   :src="'/assets/moca/' + a + '.png'" :alt="a" />
            </div>
            <div v-else-if="curQuizItem.emojis" class="qx-emoji">
              <span v-for="(e, i) in curQuizItem.emojis" :key="i">{{ e }}</span>
            </div>
          </div>
        </div>
        <button v-show="!qxPanel.open" type="button" class="qx-rail" @click="qxPanel.open = true" title="展开评估要点">
          <span class="qx-rail-ic" v-html="hsIcon('UI-CHEVRON', 15)"></span>
          <span class="qx-rail-t">评估要点</span>
        </button>
        <aside class="qx-panel" v-show="qxPanel.open">
          <div class="qx-phd">
            <b>第 {{ quiz.idx + 1 }} / {{ quizItems.length }} 题</b>
            <span style="margin-left:auto">{{ curQuizItem.g }}</span>
            <button type="button" class="qx-fold" @click="qxPanel.open = false" title="收起评估要点">
              <span v-html="hsIcon('UI-CHEVRON', 15)"></span>
            </button>
          </div>
          <div v-if="curQuizGuide && curQuizGuide.o" class="qx-sec">
            <div class="qx-lb">评估操作</div>
            <div class="qx-tx">{{ curQuizGuide.o }}</div>
          </div>
          <div v-if="curQuizGuide && curQuizGuide.n" class="qx-sec">
